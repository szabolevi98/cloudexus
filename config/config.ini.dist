[database]
host = 127.0.0.1
port = 3306
name = cloudexus
user = root
password =
charset = utf8mb4

[app]
name = "Cloudexus"
env = dev
debug = 1
base_url = "http://localhost/Cloudexus/web"
timezone = "Europe/Budapest"
; alapértelmezett nyelv (új látogatónak, ha nincs mentett választása)
default_locale = "hu"
available_locales = "hu,en"

[session]
name = cloudexus_session
; élettartam másodpercben (alap: 30 nap)
lifetime = 2592000
; ennyi sikertelen webes belépés után 15 percre letiltjuk az IP-t
login_max_failures = 10

[company]
name = "Mintacég Kft."
address = "1111 Budapest, Példa utca 1."
tax_number = "12345678-2-42"
bank_account = "11111111-22222222-33333333"
email = "info@mintaceg.hu"
phone = "+36 1 234 5678"

[mail]
host =
port = 587
username =
password =
from_address = "no-reply@cloudexus.local"
from_name = "Cloudexus"

[recaptcha]
enabled = 0
; https://www.google.com/recaptcha/admin -> v3 site
site_key =
secret_key =
; v3 score küszöb (0.0-1.0), ez alatt a bejelentkezés elutasítva
min_score = 0.5

[api]
; API user-enkénti kérésszám-korlát percenként (lásd ApiController::authenticate())
rate_limit_per_minute = 60
; ennyi napig tartjuk meg az api_request_logs sorokat, azon túl önműködően törlődnek
log_retention_days = 14
; felhasználói (mobil app) token élettartama napban; minden kéréssel újraindul
user_token_lifetime_days = 90
; ennyi sikertelen POST /api/auth/login után 15 percre letiltjuk az IP-t
login_max_failures = 10

[proxy]
; Reverse proxy / CDN mögötti telepítéshez, hogy az API-log és a bejelentkezés-korlát a
; látogató valódi IP-címét lássa. Cloudflare-hez nem kell beállítás: a CF-Connecting-IP
; fejlécet a rendszer magától elfogadja, de csak Cloudflare címtartományból érkező kérésnél.
; Más proxy (nginx, terheléselosztó) esetén itt kell megadni a címét vagy CIDR tartományát,
; vesszővel elválasztva. Üresen a REMOTE_ADDR számít (nincs proxy).
trusted_proxies =
; a fejléc, amibe a fenti proxy a látogató címét írja
client_ip_header = "X-Forwarded-For"
