{% extends 'common/layout.twig' %}

{% block content %}
    {% set scope = rule is null ? 'all' : (rule.product_id ? 'product' : (rule.category_id ? 'category' : 'all')) %}
    {% set effect = rule is not null and rule.fixed_price is not null ? 'fixed' : 'percent' %}
    <div class="cx-card" style="max-width: 760px;">
        <div class="cx-card__header">
            <h2>{{ rule ? t('price_rules.edit') : t('price_rules.new') }}</h2>
            <a href="{{ base_url }}/price-rules" class="btn btn-sm btn-outline-secondary">{{ t('common.back_to_list') }}</a>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/price-rules{{ rule ? '/' ~ rule.id : '/create' }}">
                <div class="mb-3">
                    <label for="name" class="form-label">{{ t('common.name') }}</label>
                    <input type="text" id="name" name="name" class="form-control" maxlength="120" value="{{ rule.name|default('') }}"
                           placeholder="{{ t('price_rules.name_placeholder') }}" required autofocus>
                </div>

                <h3 class="fs-6 fw-semibold border-top pt-3 mt-4">{{ t('price_rules.conditions') }}</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="customer_group_id" class="form-label">{{ t('price_rules.who') }}</label>
                        <select id="customer_group_id" name="customer_group_id" class="form-select">
                            <option value="">{{ t('price_rules.everyone') }}</option>
                            {% for g in groups %}
                                <option value="{{ g.id }}" {{ rule.customer_group_id|default(0) == g.id ? 'selected' : '' }}>{{ g.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="min_quantity" class="form-label">{{ t('price_rules.min_quantity') }}</label>
                        <input type="number" step="0.001" min="0" id="min_quantity" name="min_quantity" class="form-control"
                               value="{{ rule and rule.min_quantity > 0 ? rule.min_quantity + 0 : '' }}" placeholder="{{ t('price_rules.any_quantity') }}">
                        <div class="form-text">{{ t('price_rules.min_quantity_hint') }}</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label d-block">{{ t('price_rules.what') }}</label>
                        {% for s in ['all', 'category', 'product'] %}
                            <div class="form-check form-check-inline">
                                <input class="form-check-input cx-rule-scope" type="radio" name="scope" id="scope_{{ s }}" value="{{ s }}" {{ scope == s ? 'checked' : '' }}>
                                <label class="form-check-label" for="scope_{{ s }}">{{ t('price_rules.scope.' ~ s) }}</label>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="col-md-8 cx-rule-scope-field" data-scope="category">
                        <select name="category_id" class="form-select cx-ajax-select" data-url="{{ base_url }}/categories/search" data-placeholder="{{ t('price_rules.choose_category') }}">
                            {% if rule and rule.category_id %}<option value="{{ rule.category_id }}" selected>{{ rule.category_name }}</option>{% endif %}
                        </select>
                        <div class="form-text">{{ t('price_rules.category_hint') }}</div>
                    </div>
                    <div class="col-md-8 cx-rule-scope-field" data-scope="product">
                        <select name="product_id" class="form-select cx-ajax-select" data-url="{{ base_url }}/products/search" data-placeholder="{{ t('price_rules.choose_product') }}">
                            {% if rule and rule.product_id %}<option value="{{ rule.product_id }}" selected>{{ rule.product_sku }} — {{ rule.product_name }}</option>{% endif %}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="valid_from" class="form-label">{{ t('price_rules.valid_from') }}</label>
                        <input type="date" id="valid_from" name="valid_from" class="form-control" value="{{ rule.valid_from|default('') }}">
                    </div>
                    <div class="col-md-6">
                        <label for="valid_to" class="form-label">{{ t('price_rules.valid_to') }}</label>
                        <input type="date" id="valid_to" name="valid_to" class="form-control" value="{{ rule.valid_to|default('') }}">
                    </div>
                </div>

                <h3 class="fs-6 fw-semibold border-top pt-3 mt-4">{{ t('price_rules.effect') }}</h3>
                <div class="row g-3 align-items-end">
                    <div class="col-12">
                        {% for e in ['percent', 'fixed'] %}
                            <div class="form-check form-check-inline">
                                <input class="form-check-input cx-rule-effect" type="radio" name="effect" id="effect_{{ e }}" value="{{ e }}" {{ effect == e ? 'checked' : '' }}>
                                <label class="form-check-label" for="effect_{{ e }}">{{ t('price_rules.effects.' ~ e) }}</label>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="col-md-4 cx-rule-effect-field" data-effect="percent">
                        <div class="input-group">
                            <input type="number" step="0.01" min="0.01" max="99.99" name="discount_percent" class="form-control"
                                   value="{{ rule.discount_percent|default('') is not empty ? rule.discount_percent + 0 : '' }}" aria-label="{{ t('price_rules.effects.percent') }}">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-4 cx-rule-effect-field" data-effect="fixed">
                        <div class="input-group">
                            <input type="number" step="0.01" min="0" name="fixed_price" class="form-control"
                                   value="{{ rule.fixed_price|default('') is not empty ? rule.fixed_price + 0 : '' }}" aria-label="{{ t('price_rules.effects.fixed') }}">
                            <span class="input-group-text">{{ currency_symbol() }}</span>
                        </div>
                    </div>
                    <div class="col-12"><div class="form-text">{{ t('price_rules.effect_hint') }}</div></div>
                </div>

                <div class="form-check mt-4 mb-4">
                    <input type="checkbox" id="is_active" name="is_active" class="form-check-input" {{ rule is null or rule.is_active ? 'checked' : '' }}>
                    <label for="is_active" class="form-check-label">{{ t('common.active') }}</label>
                </div>

                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                <a href="{{ base_url }}/price-rules" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function sync(radioClass, fieldClass, attr) {
                const value = document.querySelector('.' + radioClass + ':checked')?.value;
                document.querySelectorAll('.' + fieldClass).forEach((el) => {
                    const on = el.dataset[attr] === value;
                    el.classList.toggle('d-none', !on);
                    el.querySelectorAll('input, select').forEach((input) => { input.disabled = !on; });
                });
            }
            const scope = () => sync('cx-rule-scope', 'cx-rule-scope-field', 'scope');
            const effect = () => sync('cx-rule-effect', 'cx-rule-effect-field', 'effect');
            document.querySelectorAll('.cx-rule-scope').forEach((r) => r.addEventListener('change', scope));
            document.querySelectorAll('.cx-rule-effect').forEach((r) => r.addEventListener('change', effect));
            scope();
            effect();
        });
    </script>
{% endblock %}
