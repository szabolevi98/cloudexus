{% extends 'common/auth-frame.twig' %}

{% block title %}{{ t('auth.forgot_title') }}{% endblock %}
{% block subtitle %}{{ t('auth.forgot_title') }}{% endblock %}

{% block card %}
    {% if not mail_enabled %}
        <p>{{ t('auth.forgot_no_mail') }}</p>
    {% elseif not sent %}
        <p class="small text-muted">{{ t('auth.forgot_lead') }}</p>
        <form method="post" action="{{ base_url }}/forgot-password" data-recaptcha="forgot">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="recaptcha_token">
            <div class="mb-4">
                <label for="login" class="form-label">{{ t('auth.username') }}</label>
                <div class="input-group">
                    <span class="input-group-text bg-body"><i class="bi bi-person"></i></span>
                    <input type="text" id="login" name="login" class="form-control" autocomplete="username" required autofocus>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">{{ t('auth.forgot_submit') }}</button>
        </form>
    {% endif %}
    <p class="text-center mt-3 mb-0 small"><a href="{{ base_url }}/login">{{ t('auth.start_again') }}</a></p>
{% endblock %}
