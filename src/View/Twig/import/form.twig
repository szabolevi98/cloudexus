{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 720px;">
        <div class="cx-card__header">
            <h2>{{ t('import.title_' ~ kind) }}</h2>
        </div>
        <div class="cx-card__body">
            <p class="text-muted small">{{ t('import.intro_' ~ kind) }}</p>
            <ul class="small text-muted">
                <li>{{ t('import.rule_columns') }}</li>
                <li>{{ t('import.rule_empty') }}</li>
                <li>{{ t('import.rule_preview') }}</li>
            </ul>
            <p class="small mb-1 fw-semibold">{{ t('import.known_columns') }}</p>
            <p class="small">
                {% for field in fields %}<code>{{ t('import.field_' ~ field) }}</code>{{ not loop.last ? ', ' }}{% endfor %}
            </p>
            <p class="small"><a href="{{ base_url }}{{ export_url }}"><i class="bi bi-download me-1"></i>{{ t('import.sample') }}</a></p>

            <form method="post" action="{{ base_url }}/import/{{ kind }}" enctype="multipart/form-data" class="mt-3">
                <div class="mb-3">
                    <label for="file" class="form-label">{{ t('import.file') }}</label>
                    <input type="file" id="file" name="file" class="form-control" accept=".csv,text/csv,text/plain" required>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-eye me-1"></i>{{ t('import.preview') }}</button>
                <a href="{{ base_url }}/{{ kind }}" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
            </form>
        </div>
    </div>
{% endblock %}
