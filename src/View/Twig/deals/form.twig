{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card mb-3" style="max-width: 640px;">
        <div class="cx-card__header">
            <h2>{{ deal ? t('deals.edit') ~ ': ' ~ deal.title : t('deals.new') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/deals/{{ deal ? deal.id : 'create' }}" id="deal-form">
                <div class="mb-3">
                    <label for="title" class="form-label">{{ t('deals.title_label') }}</label>
                    <input type="text" id="title" name="title" class="form-control" maxlength="190" value="{{ deal.title|default('') }}" required>
                </div>
                <div class="mb-3">
                    <label for="partner_id" class="form-label">{{ t('common.partner') }}</label>
                    <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                            data-url="{{ base_url }}/partners/search?role=customer" data-placeholder="{{ t('invoices.choose_partner') }}" required>
                        {% for opt in partner_option %}
                            <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="row">
                    {% if not deal %}
                        <div class="col-md-6 mb-3">
                            <label for="stage" class="form-label">{{ t('deals.stage_label') }}</label>
                            <select id="stage" name="stage" class="form-select">
                                {% for s in ['lead', 'qualified', 'proposal', 'negotiation'] %}
                                    <option value="{{ s }}" {{ stage == s ? 'selected' : '' }}>{{ t('deals.stage.' ~ s) }} ({{ stages[s] }}%)</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                    <div class="col-md-6 mb-3">
                        <label for="owner_id" class="form-label">{{ t('deals.owner') }}</label>
                        <select id="owner_id" name="owner_id" class="form-select">
                            <option value="">{{ t('todos.none_option') }}</option>
                            {% set owner = deal ? deal.owner_id : me %}
                            {% for u in users %}
                                <option value="{{ u.id }}" {{ owner == u.id ? 'selected' : '' }}>{{ u.full_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="amount" class="form-label">{{ t('deals.amount', {currency: currency_symbol()}) }}</label>
                        <input type="number" step="1" min="0" id="amount" name="amount" class="form-control" value="{{ deal ? deal.amount|round : '' }}" placeholder="0">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="probability" class="form-label">{{ t('deals.probability') }} (%)</label>
                        <input type="number" step="1" min="0" max="100" id="probability" name="probability" class="form-control"
                               value="{{ deal and deal.probability is not null ? deal.probability : '' }}" placeholder="{{ stages[stage] }}">
                        <div class="form-text">{{ t('deals.probability_help') }}</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="expected_close" class="form-label">{{ t('deals.expected_close') }}</label>
                        <input type="date" id="expected_close" name="expected_close" class="form-control" value="{{ deal.expected_close|default('') }}">
                    </div>
                </div>
                <div class="mb-4">
                    <label for="note" class="form-label">{{ t('deals.note') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                    <textarea id="note" name="note" class="form-control" rows="3" maxlength="4000">{{ deal.note|default('') }}</textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ t('common.save') }}</button>
                    <a href="{{ base_url }}/deals{{ deal ? '/' ~ deal.id : '' }}" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
