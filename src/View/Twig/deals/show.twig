{% extends 'common/layout.twig' %}

{% block content %}
    {% set badge = {
        lead: 'bg-secondary-subtle text-secondary-emphasis',
        qualified: 'bg-info-subtle text-info-emphasis',
        proposal: 'bg-primary-subtle text-primary-emphasis',
        negotiation: 'bg-warning-subtle text-warning-emphasis',
        won: 'text-bg-success',
        lost: 'bg-danger-subtle text-danger-emphasis'
    } %}
    <div class="cx-card mb-3">
        <div class="cx-card__header">
            <div>
                <h2>{{ deal.title }}</h2>
                <div class="text-muted small">
                    <a href="{{ base_url }}/partners/{{ deal.partner_id }}" class="text-decoration-none">{{ deal.partner_name }}</a>
                    {% if deal.owner_name %} · <i class="bi bi-person"></i> {{ deal.owner_name }}{% endif %}
                </div>
            </div>
            <span class="badge rounded-pill {{ badge[deal.stage] }}" id="deal-stage">{{ t('deals.stage.' ~ deal.stage) }}</span>
        </div>
        {% if can('crm.manage') %}
            <div class="cx-card__body border-bottom">
                <div class="d-flex flex-wrap gap-2" role="group" aria-label="{{ t('deals.stage_label') }}">
                    {% for s in ['lead', 'qualified', 'proposal', 'negotiation', 'won'] %}
                        <form method="post" action="{{ base_url }}/deals/{{ deal.id }}/move">
                            <input type="hidden" name="stage" value="{{ s }}">
                            <button type="submit" class="btn btn-sm {{ deal.stage == s ? (s == 'won' ? 'btn-success' : 'btn-primary') : (s == 'won' ? 'btn-outline-success' : 'btn-outline-secondary') }}"
                                    {{ deal.stage == s ? 'disabled aria-current="step"' : '' }} data-stage-button="{{ s }}">
                                {% if s == 'won' %}<i class="bi bi-trophy me-1"></i>{% endif %}{{ t('deals.stage.' ~ s) }}
                            </button>
                        </form>
                    {% endfor %}
                    <button type="button" class="btn btn-sm {{ deal.stage == 'lost' ? 'btn-danger' : 'btn-outline-danger' }}" data-bs-toggle="collapse" data-bs-target="#deal-lose" aria-expanded="false" aria-controls="deal-lose">
                        {{ t('deals.stage.lost') }}
                    </button>
                </div>
                <div class="collapse" id="deal-lose">
                    <form method="post" action="{{ base_url }}/deals/{{ deal.id }}/move" class="d-flex flex-wrap gap-2 align-items-end mt-3">
                        <input type="hidden" name="stage" value="lost">
                        <div class="flex-grow-1">
                            <label for="lose-reason" class="form-label small">{{ t('deals.lost_reason') }}</label>
                            <input type="text" id="lose-reason" name="reason" class="form-control form-control-sm" maxlength="255" value="{{ deal.lost_reason }}" required>
                        </div>
                        <button type="submit" class="btn btn-sm btn-danger">{{ t('deals.lose') }}</button>
                    </form>
                </div>
            </div>
        {% endif %}
        <div class="cx-card__body">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="small text-muted">{{ t('deals.amount_short') }}</div>
                    <div class="fs-5 fw-semibold">{{ deal.amount|money }}</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="small text-muted">{{ t('deals.probability') }}</div>
                    <div class="fs-5 fw-semibold">{{ deal.chance }}%</div>
                    {% if deal.is_open %}<div class="small text-muted">{{ deal.probability is null ? t('deals.stage_default') : t('deals.own_value') }}</div>{% endif %}
                </div>
                <div class="col-6 col-md-3">
                    <div class="small text-muted">{{ t('deals.weighted') }}</div>
                    <div class="fs-5 fw-semibold">{{ deal.weighted|money }}</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="small text-muted">{{ deal.is_open ? t('deals.expected_close') : t('deals.closed_at') }}</div>
                    <div class="fs-5 fw-semibold {{ deal.is_late ? 'text-danger' : '' }}">
                        {{ deal.is_open ? (deal.expected_close ?: '—') : deal.closed_at|date('Y-m-d') }}
                    </div>
                    {% if deal.is_late %}<div class="small text-danger">{{ t('deals.late') }}</div>{% endif %}
                </div>
            </div>
            {% if deal.stage == 'lost' and deal.lost_reason %}
                <div class="alert alert-danger small mt-3 mb-0"><i class="bi bi-x-circle me-1"></i>{{ t('deals.lost_reason') }}: {{ deal.lost_reason }}</div>
            {% endif %}
            {% if deal.note %}
                <div class="mt-3" style="white-space: pre-line;">{{ deal.note }}</div>
            {% endif %}
        </div>
        <div class="cx-card__body border-top small">
            {% if deal.quote_id %}
                <div>
                    <i class="bi bi-file-earmark-text me-1"></i>{{ t('deals.quote') }}:
                    {% if can_see_quotes %}<a href="{{ base_url }}/quotes/{{ deal.quote_id }}">{{ deal.quote_number }}</a>{% else %}{{ deal.quote_number }}{% endif %}
                    · {{ t('quotes.status.' ~ deal.quote_status) }}
                </div>
            {% else %}
                <div class="text-muted"><i class="bi bi-file-earmark-text me-1"></i>{{ t('deals.no_quote') }}</div>
            {% endif %}
            {% if deal.order_id %}
                <div><i class="bi bi-cart-check me-1"></i>{{ t('deals.order') }}: {% if can_see_quotes %}<a href="{{ base_url }}/orders/{{ deal.order_id }}">{{ deal.order_number }}</a>{% else %}{{ deal.order_number }}{% endif %}</div>
            {% endif %}
            <div class="text-muted mt-1">{{ t('deals.created_at', {date: deal.created_at|date('Y-m-d')}) }}</div>
        </div>
    </div>

    <div class="cx-card mb-3" id="deal-todos">
        <div class="cx-card__header"><h2>{{ t('todos.list_title') }}</h2></div>
        {% if can('crm.manage') %}
            <div class="cx-card__body border-bottom">
                <form method="post" action="{{ base_url }}/todos/create" class="row g-2 align-items-end" id="deal-todo-form">
                    <input type="hidden" name="deal_id" value="{{ deal.id }}">
                    <input type="hidden" name="partner_id" value="{{ deal.partner_id }}">
                    {% if deal.quote_id %}<input type="hidden" name="quote_id" value="{{ deal.quote_id }}">{% endif %}
                    <input type="hidden" name="assigned_to" value="{{ deal.owner_id }}">
                    <input type="hidden" name="return" value="/deals/{{ deal.id }}">
                    <div class="col-md-5">
                        <label for="deal-todo-title" class="form-label small">{{ t('todos.title_label') }}</label>
                        <input type="text" id="deal-todo-title" name="title" class="form-control form-control-sm" maxlength="200" required>
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="deal-todo-type" class="form-label small">{{ t('todos.type_label') }}</label>
                        <select id="deal-todo-type" name="type" class="form-select form-select-sm">
                            {% for type in ['call', 'email', 'meeting', 'task'] %}<option value="{{ type }}">{{ t('todos.type.' ~ type) }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="deal-todo-date" class="form-label small">{{ t('todos.due_date') }}</label>
                        <input type="date" id="deal-todo-date" name="due_date" class="form-control form-control-sm">
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="deal-todo-time" class="form-label small">{{ t('todos.due_time') }}</label>
                        <input type="time" id="deal-todo-time" name="due_time" class="form-control form-control-sm">
                    </div>
                    <div class="col-6 col-md-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100" aria-label="{{ t('common.add') }}"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </form>
            </div>
        {% endif %}
        {% if todos is empty %}
            <div class="cx-card__body text-muted small">{{ t('todos.none_linked') }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table cx-table align-middle mb-0"><tbody>
                    {% for todo in todos %}{% include 'todos/_row.twig' with {return: '/deals/' ~ deal.id} %}{% endfor %}
                </tbody></table>
            </div>
        {% endif %}
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a href="{{ base_url }}/deals" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>{{ t('deals.back') }}</a>
        {% if can('crm.manage') %}
            <a href="{{ base_url }}/deals/{{ deal.id }}/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i>{{ t('common.edit') }}</a>
            {% if can_quote and not deal.quote_id and deal.is_open %}
                <a href="{{ base_url }}/quotes/create?partner_id={{ deal.partner_id }}&amp;deal_id={{ deal.id }}" class="btn btn-primary" id="deal-quote"><i class="bi bi-file-earmark-plus me-1"></i>{{ t('deals.make_quote') }}</a>
            {% endif %}
            <form method="post" action="{{ base_url }}/deals/{{ deal.id }}/delete" data-confirm="{{ t('common.confirm_delete') }}" class="ms-auto">
                <button type="submit" class="btn btn-outline-danger" aria-label="{{ t('common.delete') }}"><i class="bi bi-trash"></i></button>
            </form>
        {% endif %}
    </div>
{% endblock %}
