{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 560px;">
        <div class="cx-card__header">
            <h2>{{ user ? t('users.edit') : t('users.new') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/users{{ user ? '/' ~ user.id : '/create' }}">
                <div class="mb-3">
                    <label for="username" class="form-label">{{ t('users.username') }}</label>
                    <input type="text" id="username" name="username" class="form-control" value="{{ user.username|default('') }}" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">{{ t('users.email') }}</label>
                    <input type="email" id="email" name="email" class="form-control" value="{{ user.email|default('') }}" required>
                </div>
                <div class="mb-3">
                    <label for="full_name" class="form-label">{{ t('users.full_name') }}</label>
                    <input type="text" id="full_name" name="full_name" class="form-control" value="{{ user.full_name|default('') }}" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">
                        {{ t('users.password') }} {% if user %}<span class="text-muted small">{{ t('users.password_unchanged_hint') }}</span>{% endif %}
                    </label>
                    <input type="password" id="password" name="password" class="form-control" {{ user ? '' : 'required' }}>
                </div>
                <div class="mb-3">
                    <label for="role" class="form-label">{{ t('users.role') }}</label>
                    <select id="role" name="role_id" class="form-select" required>
                        {% for role in roles %}
                            <option value="{{ role.id }}" {{ (user.role_id|default(null) == role.id) or (user is null and role.code == 'viewer') ? 'selected' : '' }}>{{ role.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-check mb-4">
                    <input type="checkbox" id="is_active" name="is_active" class="form-check-input" {{ (user is null or user.is_active) ? 'checked' : '' }}>
                    <label for="is_active" class="form-check-label">{{ t('common.active') }}</label>
                </div>
                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                <a href="{{ base_url }}/users" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
            </form>
        </div>
    </div>
{% endblock %}
