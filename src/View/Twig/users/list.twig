{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('users.list_title') }}</h2>
            <a href="{{ base_url }}/users/create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>{{ t('users.new') }}
            </a>
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                {{ sort_inputs() }}
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('users.search_placeholder') }}" value="{{ filters.q }}">
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/users" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th {{ sort_aria('username') }}>{{ sort_link('username', t('users.username')) }}</th>
                        <th {{ sort_aria('name') }}>{{ sort_link('name', t('common.name')) }}</th>
                        <th {{ sort_aria('email') }}>{{ sort_link('email', t('users.email')) }}</th>
                        <th {{ sort_aria('role') }}>{{ sort_link('role', t('users.role')) }}</th>
                        <th {{ sort_aria('status') }}>{{ sort_link('status', t('common.status')) }}</th>
                        <th {{ sort_aria('last_login') }}>{{ sort_link('last_login', t('users.last_login')) }}</th>
                        <th class="text-end">{{ t('common.actions') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="fw-medium">{{ user.username }}</td>
                            <td>
                                {{ user.full_name }}
                                {% if user.totp_enabled_at %}<span class="badge rounded-pill bg-success-subtle text-success-emphasis ms-1" title="{{ t('two_factor.badge_title') }}">{{ t('two_factor.badge') }}</span>{% endif %}
                            </td>
                            <td class="text-muted">{{ user.email }}</td>
                            <td>
                                <span class="badge rounded-pill {{ user.role_code == 'super_admin' ? 'text-bg-primary' : 'text-bg-secondary' }}">{{ user.role_name ?: '—' }}</span>
                            </td>
                            <td>
                                {% if user.is_active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('common.active') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('common.inactive') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ user.last_login_at ?: '—' }}</td>
                            <td class="text-end">
                                <a href="{{ base_url }}/users/{{ user.id }}/edit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                {% if user.id != auth_user_id %}
                                    <form method="post" action="{{ base_url }}/users/{{ user.id }}/delete" class="d-inline" data-confirm="{{ t('users.confirm_delete') }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">{{ t('users.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
