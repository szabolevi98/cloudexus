{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('orders.list_title') }}</h2>
            {% if can('orders.manage') %}
                <a href="{{ base_url }}/orders/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>{{ t('orders.new') }}
                </a>
            {% endif %}
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                {{ sort_inputs() }}
                <div class="row g-2 align-items-end">
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('orders.order_number') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="REND-…" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.partner') }}</label>
                        <select name="partner_id" class="form-select form-select-sm cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=customer" data-placeholder="{{ t('common.all') }}">
                            {% for opt in partner_option|default([]) %}
                                <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="confirmed" {{ filters.status == 'confirmed' ? 'selected' : '' }}>{{ t('common.order_status.confirmed') }}</option>
                            <option value="invoiced" {{ filters.status == 'invoiced' ? 'selected' : '' }}>{{ t('common.order_status.invoiced') }}</option>
                            <option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>{{ t('common.order_status.cancelled') }}</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.date_from') }}</label>
                        <input type="date" name="date_from" class="form-control form-control-sm" value="{{ filters.date_from }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.date_to') }}</label>
                        <input type="date" name="date_to" class="form-control form-control-sm" value="{{ filters.date_to }}">
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/orders" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th {{ sort_aria('number') }}>{{ sort_link('number', t('orders.order_number')) }}</th>
                        <th {{ sort_aria('partner') }}>{{ sort_link('partner', t('common.partner')) }}</th>
                        <th {{ sort_aria('date') }}>{{ sort_link('date', t('common.date')) }}</th>
                        <th {{ sort_aria('status') }}>{{ sort_link('status', t('common.status')) }}</th>
                        <th class="text-end" {{ sort_aria('total') }}>{{ sort_link('total', t('common.total')) }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for order in orders %}
                        <tr>
                            <td class="fw-medium">{{ order.order_number }}</td>
                            <td>{{ order.partner_name }}</td>
                            <td class="text-muted">{{ order.order_date }}</td>
                            <td>
                                {% if order.status == 'draft' %}
                                    <span class="badge rounded-pill text-bg-secondary">{{ t('common.order_status.draft') }}</span>
                                {% elseif order.status == 'confirmed' %}
                                    <span class="badge rounded-pill text-bg-primary">{{ t('common.order_status.confirmed') }}</span>
                                {% elseif order.status == 'invoiced' %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('common.order_status.invoiced') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('common.order_status.cancelled') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">{{ order.total_amount|money }}</td>
                            <td class="text-end">
                                <a href="{{ base_url }}/orders/{{ order.id }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">{{ t('orders.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
