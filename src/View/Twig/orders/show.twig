{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <div>
                <h2>{{ order.order_number }}</h2>
                <div class="text-muted small">{{ order.partner_name }} · {{ order.order_date }}</div>
            </div>
            <div>
                {% if order.status == 'draft' %}
                    <span class="badge rounded-pill text-bg-secondary">{{ t('common.order_status.draft') }}</span>
                {% elseif order.status == 'confirmed' %}
                    <span class="badge rounded-pill text-bg-primary">{{ t('common.order_status.confirmed') }}</span>
                {% elseif order.status == 'invoiced' %}
                    <span class="badge rounded-pill text-bg-success-subtle text-success-emphasis">{{ t('common.order_status.invoiced') }}</span>
                {% else %}
                    <span class="badge rounded-pill text-bg-danger-subtle text-danger-emphasis">{{ t('common.order_status.cancelled') }}</span>
                {% endif %}
            </div>
        </div>
        {% if order.shipping_address_id or order.billing_address_id %}
            <div class="cx-card__body border-bottom pt-3 pb-3">
                <div class="row small">
                    {% if order.shipping_address_id %}
                        <div class="col-md-6">
                            <div class="text-muted mb-1">{{ t('orders.shipping_address') }}</div>
                            <div>
                                {% if order.shipping_country and order.shipping_country != 'Magyarország' %}{{ order.shipping_country }}, {% endif %}
                                {{ order.shipping_postal_code }} {{ order.shipping_city }}, {{ order.shipping_street }}
                                {% if order.shipping_note %}<div class="text-muted">{{ order.shipping_note }}</div>{% endif %}
                            </div>
                        </div>
                    {% endif %}
                    {% if order.billing_address_id %}
                        <div class="col-md-6">
                            <div class="text-muted mb-1">{{ t('orders.billing_address') }}</div>
                            <div>
                                {% if order.billing_country and order.billing_country != 'Magyarország' %}{{ order.billing_country }}, {% endif %}
                                {{ order.billing_postal_code }} {{ order.billing_city }}, {{ order.billing_street }}
                                {% if order.billing_note %}<div class="text-muted">{{ order.billing_note }}</div>{% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        <div class="cx-card__body p-0">
            <div class="table-responsive">
                <table class="table cx-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>{{ t('common.sku') }}</th>
                        <th>{{ t('orders.product_name') }}</th>
                        <th class="text-end">{{ t('common.quantity') }}</th>
                        <th class="text-end">{{ t('common.unit_price') }}</th>
                        <th class="text-end">{{ t('common.line_total') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in order.items %}
                        <tr>
                            <td>{{ item.sku }}</td>
                            <td>{{ item.product_name }}</td>
                            <td class="text-end">{{ item.quantity|number_format(0, ',', ' ') }} {{ item.unit }}</td>
                            <td class="text-end">{{ item.unit_price|money }}</td>
                            <td class="text-end">{{ item.line_total|money }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    {% if order.shipping_cost > 0 %}
                        <tr>
                            <td colspan="4" class="text-end text-muted">{{ t('orders.shipping_cost_row') }}</td>
                            <td class="text-end text-muted">{{ order.shipping_cost|money }}</td>
                        </tr>
                    {% endif %}
                    {% if order.payment_cost > 0 %}
                        <tr>
                            <td colspan="4" class="text-end text-muted">{{ t('orders.payment_cost_row') }}</td>
                            <td class="text-end text-muted">{{ order.payment_cost|money }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td colspan="4" class="text-end fw-medium">{{ t('common.total') }}</td>
                        <td class="text-end fw-bold">{{ order.total_amount|money }}</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ base_url }}/orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>{{ t('common.back_to_list') }}
        </a>
        {% if order.status != 'invoiced' and order.status != 'cancelled' %}
            {% if can('invoices.issue') %}
                <a href="{{ base_url }}/invoices/create?order_id={{ order.id }}" class="btn btn-primary">
                    <i class="bi bi-receipt me-1"></i>{{ t('orders.make_invoice') }}
                </a>
            {% endif %}
            {% if can('orders.manage') %}
                <form method="post" action="{{ base_url }}/orders/{{ order.id }}/cancel" onsubmit="return confirm('{{ t('orders.confirm_void')|e('js') }}');">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>{{ t('orders.void') }}
                    </button>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
