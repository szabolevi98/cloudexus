{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('orders.new_full') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/orders/create" id="order-form">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">{{ t('orders.order_number') }}</label>
                        <input type="text" name="order_number" class="form-control" value="{{ order_number }}" readonly>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="partner_id" class="form-label">{{ t('orders.partner_customer') }}</label>
                        <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=customer" data-placeholder="{{ t('orders.choose_partner') }}" required></select>
                        {% include 'common/partner-credit.twig' %}
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">{{ t('orders.order_date') }}</label>
                        <input type="date" name="order_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="shipping_address_id" class="form-label">{{ t('orders.shipping_address') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                        <select id="shipping_address_id" name="shipping_address_id" class="form-select" data-empty-some="{{ t('orders.address_not_selected') }}" data-empty-none="{{ t('orders.partner_no_address') }}">
                            <option value="">{{ t('orders.choose_partner_first') }}</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="billing_address_id" class="form-label">{{ t('orders.billing_address') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                        <select id="billing_address_id" name="billing_address_id" class="form-select">
                            <option value="">{{ t('orders.choose_partner_first') }}</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="shipping_cost" class="form-label">{{ t('orders.shipping_cost', {'currency': currency_symbol()}) }}</label>
                        <input type="number" step="0.01" min="0" id="shipping_cost" name="shipping_cost" class="form-control cx-order-cost" value="0">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="payment_cost" class="form-label">{{ t('orders.payment_cost', {'currency': currency_symbol()}) }} <span class="text-muted small">{{ t('orders.payment_cost_hint') }}</span></label>
                        <input type="number" step="0.01" min="0" id="payment_cost" name="payment_cost" class="form-control cx-order-cost" value="0">
                    </div>
                </div>

                {% include 'common/line-items.twig' with {partner_select_id: 'partner_id', extra_cost_selector: '.cx-order-cost', date_input_name: 'order_date'} %}

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ base_url }}/orders" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>{{ t('orders.create_order') }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script type="application/json" id="partner-addresses">{{ js_data(partner_addresses|default([])) }}</script>
{% endblock %}
