{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('locations.list_title') }}</h2>
            {% if can('warehouses.manage') %}
                <a href="{{ base_url }}/locations/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>{{ t('locations.new') }}
                </a>
            {% endif %}
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('locations.search_placeholder') }}" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.warehouse') }}</label>
                        <select name="warehouse_id" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            {% for w in warehouses %}
                                <option value="{{ w.id }}" {{ filters.warehouse_id == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{{ t('common.active') }}</option>
                            <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>{{ t('common.inactive') }}</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/locations" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th>{{ t('common.warehouse') }}</th>
                        <th>{{ t('locations.code') }}</th>
                        <th>{{ t('locations.name') }}</th>
                        <th class="text-end">{{ t('locations.stock') }}</th>
                        <th class="text-end">{{ t('locations.product_kinds') }}</th>
                        <th>{{ t('common.status') }}</th>
                        <th class="text-end">{{ t('common.actions') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for l in locations %}
                        <tr>
                            <td class="text-muted">{{ l.warehouse_name }}</td>
                            <td class="fw-medium text-nowrap">
                                <a href="{{ base_url }}/stock?location_id={{ l.id }}" class="text-decoration-none">{{ l.code }}</a>
                            </td>
                            <td>{{ l.name ?: '—' }}</td>
                            <td class="text-end">{{ l.stock_qty|qty }}</td>
                            <td class="text-end text-muted">{{ l.product_count }}</td>
                            <td>
                                {% if l.is_active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('common.active') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('common.inactive') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                {% if can('warehouses.manage') %}
                                    <a href="{{ base_url }}/locations/{{ l.id }}/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                {% endif %}
                                {% if can('warehouses.manage') %}
                                    <form method="post" action="{{ base_url }}/locations/{{ l.id }}/delete" class="d-inline" onsubmit="return confirm('{{ t('common.confirm_delete')|e('js') }}');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">{{ t('locations.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
