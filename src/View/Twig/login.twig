{% extends 'common/auth-frame.twig' %}

{% block subtitle %}{{ code_step|default(false) ? t('auth.code_lead') : t('auth.subtitle') }}{% endblock %}

{% block card %}
    {% if code_step|default(false) %}
    <form method="post" action="{{ base_url }}/login/code" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <div class="mb-4">
            <label for="code" class="form-label">{{ t('auth.code') }}</label>
            <div class="input-group">
                <span class="input-group-text bg-body"><i class="bi bi-shield-lock"></i></span>
                <input type="text" id="code" name="code" class="form-control cx-code-input" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="16" required autofocus>
            </div>
            <div class="form-text">{{ t('auth.code_hint') }}</div>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">{{ t('auth.sign_in') }}</button>
    </form>
    <p class="text-center mt-3 mb-0 small"><a href="{{ base_url }}/login">{{ t('auth.start_again') }}</a></p>
    {% else %}
    <form method="post" action="{{ base_url }}/login" id="login-form" data-recaptcha="login">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="recaptcha_token">
        <div class="mb-3">
            <label for="username" class="form-label">{{ t('auth.username') }}</label>
            <div class="input-group">
                <span class="input-group-text bg-body"><i class="bi bi-person"></i></span>
                <input type="text" id="username" name="username" class="form-control" autocomplete="username" required autofocus>
            </div>
        </div>
        <div class="mb-4">
            <label for="password" class="form-label">{{ t('auth.password') }}</label>
            <div class="input-group">
                <span class="input-group-text bg-body"><i class="bi bi-lock"></i></span>
                <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2" id="login-submit">{{ t('auth.sign_in') }}</button>
    </form>
    {% if mail_enabled|default(false) %}
        <p class="text-center mt-3 mb-0 small"><a href="{{ base_url }}/forgot-password">{{ t('auth.forgot_link') }}</a></p>
    {% endif %}
    {% endif %}
{% endblock %}
