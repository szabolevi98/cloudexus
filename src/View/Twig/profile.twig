{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 560px;">
        <div class="cx-card__header">
            <h2>{{ t('profile.title') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/profile">
                <div class="mb-3">
                    <label class="form-label">{{ t('profile.username') }}</label>
                    <input type="text" class="form-control" value="{{ user.username }}" disabled>
                </div>
                <div class="mb-3">
                    <label for="full_name" class="form-label">{{ t('profile.full_name') }}</label>
                    <input type="text" id="full_name" name="full_name" class="form-control" value="{{ user.full_name }}" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">{{ t('profile.email') }}</label>
                    <input type="email" id="email" name="email" class="form-control" value="{{ user.email }}" required>
                </div>
                <div class="mb-4">
                    <label for="theme" class="form-label">{{ t('profile.theme') }}</label>
                    <select id="theme" name="theme" class="form-select">
                        {% for mode in ['system', 'light', 'dark'] %}
                            <option value="{{ mode }}" {{ theme_mode == mode ? 'selected' : '' }}>{{ t('nav.theme_' ~ mode) }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ t('profile.theme_hint') }}</div>
                </div>

                <h3 class="fs-6 fw-semibold border-top pt-4">{{ t('profile.change_password') }} <span class="text-muted small fw-normal">{{ t('profile.change_password_hint') }}</span></h3>
                <div class="mb-3">
                    <label for="current_password" class="form-label">{{ t('profile.current_password') }}</label>
                    <input type="password" id="current_password" name="current_password" class="form-control" autocomplete="current-password">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="new_password" class="form-label">{{ t('profile.new_password') }}</label>
                        <input type="password" id="new_password" name="new_password" class="form-control" autocomplete="new-password" minlength="8">
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="new_password_confirm" class="form-label">{{ t('profile.new_password_confirm') }}</label>
                        <input type="password" id="new_password_confirm" name="new_password_confirm" class="form-control" autocomplete="new-password">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
            </form>
        </div>
    </div>

    <div class="cx-card mt-4" style="max-width: 560px;">
        <div class="cx-card__body">
            <div class="fw-semibold"><i class="bi bi-sunrise me-1"></i>{{ t('digest.title') }}</div>
            <p class="small text-muted mb-2">{{ t('digest.profile_text') }}</p>
            {% if mail_enabled %}
                <form method="post" action="{{ base_url }}/profile/digest" class="btn-group btn-group-sm" role="group" aria-label="{{ t('digest.title') }}">
                    <button type="submit" name="digest" value="1" class="btn {{ user.digest_enabled ? 'btn-primary' : 'btn-outline-primary' }}" aria-pressed="{{ user.digest_enabled ? 'true' : 'false' }}">{{ t('digest.profile_on') }}</button>
                    <button type="submit" name="digest" value="0" class="btn {{ user.digest_enabled ? 'btn-outline-secondary' : 'btn-secondary' }}" aria-pressed="{{ user.digest_enabled ? 'false' : 'true' }}">{{ t('digest.profile_off') }}</button>
                </form>
            {% else %}
                <p class="small mb-0">{{ t('digest.no_mail') }}</p>
            {% endif %}
        </div>
    </div>

    <div class="cx-card mt-4" style="max-width: 560px;">
        <div class="cx-card__body d-flex align-items-center justify-content-between gap-3">
            <div>
                <div class="fw-semibold"><i class="bi bi-shield-lock me-1"></i>{{ t('two_factor.title') }}</div>
                <div class="small text-muted">{{ user.totp_enabled_at ? t('two_factor.on_title') : t('two_factor.off_title') }}</div>
            </div>
            <a href="{{ base_url }}/profile/two-factor" class="btn btn-sm {{ user.totp_enabled_at ? 'btn-outline-secondary' : 'btn-outline-primary' }}">
                {{ user.totp_enabled_at ? t('two_factor.on') : t('two_factor.set_up') }}
            </a>
        </div>
    </div>

    {# Egy évig bent marad a böngésző az utolsó kattintástól: ez a kiút egy
       elhagyott laptopnál vagy egy közös gépnél. #}
    <div class="cx-card mt-4" style="max-width: 560px;">
        <div class="cx-card__body d-flex align-items-center justify-content-between gap-3">
            <div>
                <div class="fw-semibold"><i class="bi bi-box-arrow-right me-1"></i>{{ t('profile.sessions_title') }}</div>
                <div class="small text-muted">{{ t('profile.sessions_text') }}</div>
            </div>
            <form method="post" action="{{ base_url }}/profile/sessions/end">
                <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap" data-confirm="{{ t('profile.sessions_end_confirm') }}">{{ t('profile.sessions_end') }}</button>
            </form>
        </div>
    </div>
{% endblock %}
