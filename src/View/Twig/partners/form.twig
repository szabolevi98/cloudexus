{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card mb-3" style="max-width: 560px;">
        <div class="cx-card__header">
            <h2>{{ partner ? t('partners.edit_title') : t('partners.new') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/partners{{ partner ? '/' ~ partner.id : '/create' }}">
                <div class="mb-3">
                    <label for="name" class="form-label">{{ t('common.name') }}</label>
                    <input type="text" id="name" name="name" class="form-control" value="{{ partner.name|default('') }}" required>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="type" class="form-label">{{ t('partners.type') }}</label>
                        <select id="type" name="type" class="form-select">
                            <option value="customer" {{ partner.type == 'customer' ? 'selected' : '' }}>{{ t('partners.type_customer') }}</option>
                            <option value="supplier" {{ partner.type == 'supplier' ? 'selected' : '' }}>{{ t('partners.type_supplier') }}</option>
                            <option value="both" {{ partner.type == 'both' ? 'selected' : '' }}>{{ t('partners.type_both') }}</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="tax_number" class="form-label">{{ t('partners.tax_number') }}</label>
                        <input type="text" id="tax_number" name="tax_number" class="form-control" value="{{ partner.tax_number|default('') }}">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">{{ t('partners.email') }}</label>
                        <input type="email" id="email" name="email" class="form-control" value="{{ partner.email|default('') }}">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="phone" class="form-label">{{ t('partners.phone') }}</label>
                        <input type="text" id="phone" name="phone" class="form-control" value="{{ partner.phone|default('') }}">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="credit_limit" class="form-label">{{ t('partners.credit_limit', {currency: currency_symbol()}) }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                        <input type="number" step="1" min="0" id="credit_limit" name="credit_limit" class="form-control" value="{{ partner.credit_limit is defined and partner.credit_limit is not null ? partner.credit_limit|round : '' }}">
                        <div class="form-text">{{ t('partners.credit_limit_help') }}</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="payment_terms_days" class="form-label">{{ t('partners.payment_terms') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                        <input type="number" step="1" min="0" max="365" id="payment_terms_days" name="payment_terms_days" class="form-control" value="{{ partner.payment_terms_days|default('') }}" placeholder="8">
                        <div class="form-text">{{ t('partners.payment_terms_help') }}</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="tags" class="form-label">{{ t('partners.tags') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                    <select id="tags" name="tags[]" class="form-select cx-select2" multiple data-tags="true" data-placeholder="{{ t('partners.tags_placeholder') }}">
                        {% for tag in all_tags %}
                            <option value="{{ tag.name }}" {{ tag.name in tags ? 'selected' : '' }}>{{ tag.name }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ t('partners.tags_help') }}</div>
                </div>
                <div class="mb-3">
                    <label for="customer_group_id" class="form-label">{{ t('partners.customer_group') }}</label>
                    <select id="customer_group_id" name="customer_group_id" class="form-select cx-select2">
                        <option value="">{{ t('partners.customer_group_none') }}</option>
                        {% for g in customer_groups %}
                            <option value="{{ g.id }}" {{ partner.customer_group_id == g.id ? 'selected' : '' }}>{{ g.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% if not partner %}
                    <div class="alert alert-info small mb-3">
                        <i class="bi bi-info-circle me-1"></i>{{ t('partners.addresses_after_save') }}
                    </div>
                {% endif %}
                <div class="form-check mb-4">
                    <input type="checkbox" id="is_active" name="is_active" class="form-check-input" {{ (partner is null or partner.is_active) ? 'checked' : '' }}>
                    <label for="is_active" class="form-check-label">{{ t('common.active') }}</label>
                </div>
                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                <a href="{{ base_url }}/partners" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
            </form>
        </div>
    </div>

    {% if partner %}
        <div class="cx-card" style="max-width: 560px;">
            <div class="cx-card__header">
                <h2>{{ t('partners.addresses') }}</h2>
                <span class="text-muted small">{{ addresses|length }} {{ t('common.pcs') }}</span>
            </div>
            <div class="cx-card__body">
                {% for a in addresses %}
                    <div class="pb-2 mb-2 {{ not loop.last ? 'border-bottom' : '' }}">
                        <div class="row g-2">
                            <div class="col-4">
                                <input type="text" name="country" form="addr-{{ a.id }}" class="form-control form-control-sm" value="{{ a.country }}" placeholder="{{ t('partners.country') }}">
                            </div>
                            <div class="col-3">
                                <input type="text" name="postal_code" form="addr-{{ a.id }}" class="form-control form-control-sm" value="{{ a.postal_code }}" placeholder="{{ t('partners.postal_code') }}">
                            </div>
                            <div class="col-5">
                                <input type="text" name="city" form="addr-{{ a.id }}" class="form-control form-control-sm" value="{{ a.city }}" placeholder="{{ t('partners.city') }}">
                            </div>
                            <div class="col-8">
                                <input type="text" name="street" form="addr-{{ a.id }}" class="form-control form-control-sm" value="{{ a.street }}" placeholder="{{ t('partners.street') }}">
                            </div>
                            <div class="col-4">
                                <input type="text" name="note" form="addr-{{ a.id }}" class="form-control form-control-sm" value="{{ a.note }}" placeholder="{{ t('common.note') }}">
                            </div>
                        </div>
                        <div class="mt-2 text-end">
                            <button type="submit" form="addr-{{ a.id }}" class="btn btn-sm btn-outline-primary">{{ t('common.save') }}</button>
                            <button type="submit" form="addr-del-{{ a.id }}" class="btn btn-sm btn-outline-danger" data-confirm="{{ t('partners.confirm_delete_address') }}"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                {% else %}
                    <div class="text-muted small">{{ t('partners.no_addresses') }}</div>
                {% endfor %}
                <form method="post" action="{{ base_url }}/partners/{{ partner.id }}/addresses" class="mt-3 pt-3 border-top">
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label class="form-label small text-muted mb-1">{{ t('partners.country') }}</label>
                            <input type="text" name="country" class="form-control form-control-sm" value="Magyarország">
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label small text-muted mb-1">{{ t('partners.postal_code') }}</label>
                            <input type="text" name="postal_code" class="form-control form-control-sm" required>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">{{ t('partners.city') }}</label>
                        <input type="text" name="city" class="form-control form-control-sm" required>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">{{ t('partners.street') }}</label>
                        <input type="text" name="street" class="form-control form-control-sm" required>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.note') }} <span class="text-muted">{{ t('partners.address_note_hint') }}</span></label>
                        <input type="text" name="note" class="form-control form-control-sm">
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus-lg me-1"></i>{{ t('partners.add_address') }}</button>
                </form>
            </div>
        </div>

        {% for a in addresses %}
            <form id="addr-{{ a.id }}" method="post" action="{{ base_url }}/partners/{{ partner.id }}/addresses/{{ a.id }}"></form>
            <form id="addr-del-{{ a.id }}" method="post" action="{{ base_url }}/partners/{{ partner.id }}/addresses/{{ a.id }}/delete"></form>
        {% endfor %}
    {% endif %}
{% endblock %}
