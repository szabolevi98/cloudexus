{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('partners.list_title') }}</h2>
            <div class="d-flex gap-2">
                <a href="{{ base_url }}/partners/export?{{ filters|url_encode }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i>{{ t('common.csv_export') }}
                </a>
                {% if can('partners.manage') %}
                    <a href="{{ base_url }}/partners/create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>{{ t('partners.new') }}
                    </a>
                {% endif %}
            </div>
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                {{ sort_inputs() }}
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('partners.search_placeholder') }}" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('partners.type') }}</label>
                        <select name="type" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="customer" {{ filters.type == 'customer' ? 'selected' : '' }}>{{ t('partners.type_customer') }}</option>
                            <option value="supplier" {{ filters.type == 'supplier' ? 'selected' : '' }}>{{ t('partners.type_supplier') }}</option>
                            <option value="both" {{ filters.type == 'both' ? 'selected' : '' }}>{{ t('partners.type_both') }}</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{{ t('common.active') }}</option>
                            <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>{{ t('common.inactive') }}</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('partners.customer_group') }}</label>
                        <select name="customer_group_id" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            {% for g in customer_groups %}
                                <option value="{{ g.id }}" {{ filters.customer_group_id == g.id ? 'selected' : '' }}>{{ g.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/partners" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th {{ sort_aria('name') }}>{{ sort_link('name', t('common.name')) }}</th>
                        <th {{ sort_aria('type') }}>{{ sort_link('type', t('partners.type')) }}</th>
                        <th {{ sort_aria('tax_number') }}>{{ sort_link('tax_number', t('partners.tax_number')) }}</th>
                        <th {{ sort_aria('email') }}>{{ sort_link('email', t('partners.email')) }}</th>
                        <th {{ sort_aria('phone') }}>{{ sort_link('phone', t('partners.phone')) }}</th>
                        <th {{ sort_aria('customer_group') }}>{{ sort_link('customer_group', t('partners.customer_group')) }}</th>
                        <th {{ sort_aria('status') }}>{{ sort_link('status', t('common.status')) }}</th>
                        <th class="text-end">{{ t('common.actions') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for partner in partners %}
                        <tr>
                            <td class="fw-medium"><a href="{{ base_url }}/partners/{{ partner.id }}" class="text-decoration-none">{{ partner.name }}</a></td>
                            <td>
                                {% if partner.type == 'customer' %}
                                    <span class="badge rounded-pill text-bg-primary">{{ t('partners.type_customer') }}</span>
                                {% elseif partner.type == 'supplier' %}
                                    <span class="badge rounded-pill text-bg-secondary">{{ t('partners.type_supplier') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill text-bg-info">{{ t('partners.type_both') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ partner.tax_number ?: '—' }}</td>
                            <td class="text-muted">{{ partner.email ?: '—' }}</td>
                            <td class="text-muted">{{ partner.phone ?: '—' }}</td>
                            <td class="text-muted">{{ partner.customer_group_name ?: '—' }}</td>
                            <td>
                                {% if partner.is_active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('common.active') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('common.inactive') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ base_url }}/partners/{{ partner.id }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                {% if can('partners.manage') %}
                                    <a href="{{ base_url }}/partners/{{ partner.id }}/edit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% endif %}
                                {% if can('partners.manage') %}
                                    <form method="post" action="{{ base_url }}/partners/{{ partner.id }}/delete" class="d-inline" onsubmit="return confirm('{{ t('common.confirm_delete')|e('js') }}');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-muted py-4">{{ t('partners.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
