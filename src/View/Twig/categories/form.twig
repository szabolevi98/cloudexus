{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ category ? t('categories.edit_title') : t('categories.new') }}</h2>
                </div>
                <div class="cx-card__body">
                    <form method="post" action="{{ base_url }}/categories{{ category ? '/' ~ category.id : '/create' }}">
                        {# Nyelvenkénti fülek: a név és a leírás nyelvenként tárolódik. #}
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            {% for lang in languages %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link {{ loop.first ? 'active' : '' }}" type="button"
                                            data-bs-toggle="tab" data-bs-target="#cat-lang-{{ lang.id }}"
                                            role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ lang.name }}</button>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="tab-content mb-3">
                            {% for lang in languages %}
                                <div class="tab-pane fade {{ loop.first ? 'show active' : '' }}" id="cat-lang-{{ lang.id }}" role="tabpanel">
                                    <div class="mb-3">
                                        <label for="name-{{ lang.id }}" class="form-label">{{ t('common.name') }}{{ loop.first ? ' *' : '' }}</label>
                                        <input type="text" id="name-{{ lang.id }}" name="name[{{ lang.id }}]" class="form-control"
                                               value="{{ descriptions[lang.id].name|default('') }}" {{ loop.first ? 'required' : '' }}>
                                    </div>
                                    <div class="mb-0">
                                        <label for="description-{{ lang.id }}" class="form-label">{{ t('categories.description') }}</label>
                                        <textarea id="description-{{ lang.id }}" name="description[{{ lang.id }}]" class="tinymce-editor form-control" rows="4">{{ descriptions[lang.id].description|default('') }}</textarea>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="mb-4">
                            <label for="parent_id" class="form-label">{{ t('categories.parent') }}</label>
                            <select id="parent_id" name="parent_id" class="form-select cx-ajax-select"
                                    data-url="{{ base_url }}/categories/search{{ category ? '?exclude_id=' ~ category.id : '' }}"
                                    data-placeholder="{{ t('categories.parent_none') }}">
                                <option value=""></option>
                                {% for opt in parent_option|default([]) %}
                                    <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-check mb-4">
                            <input type="checkbox" id="is_active" name="is_active" class="form-check-input"
                                   {{ (category is null or category.is_active) ? 'checked' : '' }}>
                            <label for="is_active" class="form-check-label">{{ t('categories.is_active') }}</label>
                        </div>
                        <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                        <a href="{{ base_url }}/categories" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ base_url }}/assets/vendor/tinymce/tinymce.min.js"></script>
{% endblock %}
