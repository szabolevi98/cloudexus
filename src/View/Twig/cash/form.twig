{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 560px;">
        <div class="cx-card__header">
            <h2>{{ t('cash.new_voucher') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/cash/create">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">{{ t('cash.voucher_number') }}</label>
                        <input type="text" name="voucher_number" class="form-control" value="{{ voucher_number }}" readonly>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="type" class="form-label">{{ t('cash.type') }}</label>
                        <select id="type" name="type" class="form-select">
                            <option value="bevetel">{{ t('cash.income') }}</option>
                            <option value="kiadas">{{ t('cash.expense') }}</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="amount" class="form-label">{{ t('cash.amount_ft', {'currency': currency_symbol()}) }}</label>
                        <input type="number" step="0.01" min="0.01" id="amount" name="amount" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">{{ t('cash.date') }}</label>
                        <input type="date" name="voucher_date" class="form-control" value="{{ "now"|date("Y-m-d") }}" max="{{ "now"|date("Y-m-d") }}">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="partner_id" class="form-label">{{ t('cash.partner') }} <span class="text-muted small">{{ t('cash.optional') }}</span></label>
                    <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                            data-url="{{ base_url }}/partners/search" data-placeholder="{{ t('cash.none_option') }}"></select>
                </div>
                <div class="mb-3" id="invoice-field">
                    <label for="invoice_id" class="form-label">{{ t('cash.outgoing_invoice_to_settle') }} <span class="text-muted small">{{ t('cash.optional') }}</span></label>
                    <select id="invoice_id" name="invoice_id" class="form-select">
                        <option value="">{{ t('cash.none_option') }}</option>
                        {% for i in unpaid_invoices %}
                            <option value="{{ i.id }}" data-balance="{{ i.balance }}">{{ i.invoice_number }} — {{ i.partner_name }} ({{ t('payments.balance') }}: {{ i.balance|money }})</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ t('cash.auto_paid_hint') }}</div>
                </div>
                <div class="mb-4 d-none" id="incoming-invoice-field">
                    <label for="incoming_invoice_id" class="form-label">{{ t('cash.incoming_invoice_to_settle') }} <span class="text-muted small">{{ t('cash.optional') }}</span></label>
                    <select id="incoming_invoice_id" name="incoming_invoice_id" class="form-select">
                        <option value="">{{ t('cash.none_option') }}</option>
                        {% for i in unpaid_incoming_invoices %}
                            <option value="{{ i.id }}" data-balance="{{ i.balance }}">{{ i.invoice_number }} — {{ i.partner_name }} ({{ t('payments.balance') }}: {{ i.balance|money }})</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ t('cash.auto_paid_hint') }}</div>
                </div>
                <div class="mb-4">
                    <label for="note" class="form-label">{{ t('cash.note') }}</label>
                    <input type="text" id="note" name="note" class="form-control">
                </div>
                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                <a href="{{ base_url }}/cash" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
            </form>
        </div>
    </div>

{% endblock %}
