{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <div>
                <h2>{{ invoice.invoice_number }}</h2>
                <div class="text-muted small">
                    {{ invoice.partner_name }}
                    {% if invoice.tax_number %} · {{ t('incoming_invoices.tax_number') }}: {{ invoice.tax_number }}{% endif %}
                    {% if invoice.warehouse_name %} · {{ t('incoming_invoices.receipt_warehouse') }}: {{ invoice.warehouse_name }}{% endif %}
                </div>
            </div>
            <div>
                {% include 'common/invoice-status.twig' with {doc: invoice} %}
            </div>
        </div>
        <div class="cx-card__body p-0">
            <div class="table-responsive">
                <table class="table cx-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>{{ t('common.sku') }}</th>
                        <th>{{ t('incoming_invoices.product_name') }}</th>
                        <th class="text-end">{{ t('common.quantity') }}</th>
                        <th class="text-end">{{ t('common.unit_price') }}</th>
                        <th class="text-end">{{ t('common.line_total') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in invoice.items %}
                        <tr>
                            <td>{{ item.sku }}</td>
                            <td>{{ item.product_name }}</td>
                            <td class="text-end">{{ item.quantity|qty }} {{ item.unit }}</td>
                            <td class="text-end">{{ item.unit_price|money }}</td>
                            <td class="text-end">{{ item.line_total|money }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-medium">{{ t('common.total') }}</td>
                        <td class="text-end fw-bold">{{ invoice.total_amount|money }}</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    {% if invoice.status in ['unpaid', 'paid'] %}
        {% include 'common/payments.twig' with {doc: invoice, payments: payments, base: base_url ~ '/incoming-invoices/' ~ invoice.id, payable: invoice.status == 'unpaid'} %}
    {% endif %}

    <div class="d-flex gap-2">
        <a href="{{ base_url }}/incoming-invoices" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>{{ t('common.back_to_list') }}
        </a>
        {% if invoice.status == 'unpaid' %}
            {% if can('finance.mark_paid') %}
                <form method="post" action="{{ base_url }}/incoming-invoices/{{ invoice.id }}/mark-paid">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>{{ invoice.paid_amount > 0 ? t('payments.settle_rest') : t('incoming_invoices.mark_paid') }}
                    </button>
                </form>
            {% endif %}
            {% if can('purchasing.manage') and invoice.paid_amount == 0 %}
                <form method="post" action="{{ base_url }}/incoming-invoices/{{ invoice.id }}/cancel" onsubmit="return confirm('{{ t('incoming_invoices.confirm_void')|e('js') }}');">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>{{ t('incoming_invoices.void') }}
                    </button>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
