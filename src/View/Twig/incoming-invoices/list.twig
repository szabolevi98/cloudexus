{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('incoming_invoices.list_title') }}</h2>
            {% if can('purchasing.manage') %}
                <a href="{{ base_url }}/incoming-invoices/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>{{ t('incoming_invoices.new') }}
                </a>
            {% endif %}
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                {{ sort_inputs() }}
                <div class="row g-2 align-items-end">
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('incoming_invoices.invoice_number') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="BSZLA-…" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('incoming_invoices.supplier') }}</label>
                        <select name="partner_id" class="form-select form-select-sm cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=supplier" data-placeholder="{{ t('common.all') }}">
                            {% for opt in partner_option|default([]) %}
                                <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="unpaid" {{ filters.status == 'unpaid' ? 'selected' : '' }}>{{ t('common.invoice_status.unpaid') }}</option>
                            <option value="overdue" {{ filters.status == 'overdue' ? 'selected' : '' }}>{{ t('common.invoice_status.overdue') }}</option>
                            <option value="paid" {{ filters.status == 'paid' ? 'selected' : '' }}>{{ t('common.invoice_status.paid') }}</option>
                            <option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>{{ t('common.invoice_status.cancelled') }}</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('incoming_invoices.issued_from') }}</label>
                        <input type="date" name="date_from" class="form-control form-control-sm" value="{{ filters.date_from }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('incoming_invoices.issued_to') }}</label>
                        <input type="date" name="date_to" class="form-control form-control-sm" value="{{ filters.date_to }}">
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/incoming-invoices" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th {{ sort_aria('number') }}>{{ sort_link('number', t('incoming_invoices.invoice_number')) }}</th>
                        <th {{ sort_aria('supplier') }}>{{ sort_link('supplier', t('incoming_invoices.supplier')) }}</th>
                        <th {{ sort_aria('issue_date') }}>{{ sort_link('issue_date', t('incoming_invoices.issue_date')) }}</th>
                        <th {{ sort_aria('due_date') }}>{{ sort_link('due_date', t('incoming_invoices.due_date')) }}</th>
                        <th {{ sort_aria('status') }}>{{ sort_link('status', t('common.status')) }}</th>
                        <th class="text-end" {{ sort_aria('amount') }}>{{ sort_link('amount', t('incoming_invoices.amount')) }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set today = "now"|date("Y-m-d") %}
                    {% for invoice in invoices %}
                        <tr>
                            <td class="fw-medium">{{ invoice.invoice_number }}</td>
                            <td>{{ invoice.partner_name }}</td>
                            <td class="text-muted">{{ invoice.issue_date }}</td>
                            <td class="text-muted">{{ invoice.due_date }}</td>
                            <td>
                                {% include 'common/invoice-status.twig' with {doc: invoice} %}
                            </td>
                            <td class="text-end">{{ invoice.total_amount|money }}</td>
                            <td class="text-end">
                                <a href="{{ base_url }}/incoming-invoices/{{ invoice.id }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">{{ t('incoming_invoices.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
