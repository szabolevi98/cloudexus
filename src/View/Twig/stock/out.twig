{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3">
        {% if can('stock.move') %}
            <div class="col-lg-4">
                <div class="cx-card">
                    <div class="cx-card__header">
                        <h2>{{ t('stock.out_new') }}</h2>
                    </div>
                    <div class="cx-card__body">
                        <form method="post" action="{{ base_url }}/stock/out/create">
                            <div class="mb-3">
                                <label for="warehouse_id" class="form-label">{{ t('common.warehouse') }}</label>
                                <select id="warehouse_id" name="warehouse_id" class="form-select" required>
                                    <option value="">{{ t('stock.choose_warehouse') }}</option>
                                    {% for w in warehouses %}
                                        <option value="{{ w.id }}">{{ w.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="location_id" class="form-label">{{ t('stock.location') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                                <select id="location_id" name="location_id" class="form-select">
                                    <option value="">{{ t('stock.no_location') }}</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="product_id" class="form-label">{{ t('common.product') }}</label>
                                <select id="product_id" name="product_id" class="form-select cx-ajax-select"
                                        data-url="{{ base_url }}/products/search" data-placeholder="{{ t('common.choose_product') }}" required>
                                    {% for opt in selected_product|default([]) %}
                                        <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="quantity" class="form-label">{{ t('common.quantity') }}</label>
                                <input type="number" step="0.001" min="0" id="quantity" name="quantity" class="form-control" required {{ selected_product|default([]) ? 'autofocus' : '' }}>
                            </div>
                            <div class="mb-3">
                                <label for="note" class="form-label">{{ t('common.note') }}</label>
                                <input type="text" id="note" name="note" class="form-control">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-box-arrow-up me-1"></i>{{ t('stock.out_submit') }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
        <div class="{{ can('stock.move') ? 'col-lg-8' : 'col-12' }}">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ t('stock.out_list_title') }}</h2>
                </div>
                <div class="cx-card__body p-0">
                    <form method="get" class="p-3 border-bottom">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4 col-lg-3">
                                <label class="form-label small text-muted mb-1">{{ t('common.product') }}</label>
                                <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('stock.product_search_placeholder') }}" value="{{ filters.q }}">
                            </div>
                            <div class="col-sm-3 col-lg-3">
                                <label class="form-label small text-muted mb-1">{{ t('common.warehouse') }}</label>
                                <select name="warehouse_id" class="form-select form-select-sm">
                                    <option value="">{{ t('common.all') }}</option>
                                    {% for w in warehouses %}
                                        <option value="{{ w.id }}" {{ filters.warehouse_id == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                                <a href="{{ base_url }}/stock/out" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 cx-table">
                            <thead>
                            <tr>
                                <th>{{ t('common.date') }}</th>
                                <th>{{ t('common.warehouse') }}</th>
                                <th>{{ t('stock.location') }}</th>
                                <th>{{ t('common.product') }}</th>
                                <th class="text-end">{{ t('common.quantity') }}</th>
                                <th>{{ t('common.created_by') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for m in movements %}
                                <tr>
                                    <td class="text-muted">{{ m.created_at }}</td>
                                    <td>{{ m.warehouse_name }}</td>
                                    <td class="text-muted">{{ m.location_code ?: '—' }}</td>
                                    <td>{{ m.sku }} — {{ m.product_name }}</td>
                                    <td class="text-end text-danger fw-medium">-{{ m.quantity|number_format(0, ',', ' ') }} {{ m.unit }}</td>
                                    <td class="text-muted">{{ m.created_by_name ?: '—' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted py-4">{{ t('stock.out_none_found') }}</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% include 'common/pagination.twig' %}
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const locs = {{ locations|json_encode|raw }};
            const wh = document.getElementById('warehouse_id');
            const loc = document.getElementById('location_id');
            function fill() {
                const w = parseInt(wh.value, 10);
                loc.innerHTML = '<option value="">{{ t('stock.no_location')|e('js') }}</option>';
                locs.filter(l => l.warehouse_id == w).forEach(l => {
                    const o = document.createElement('option');
                    o.value = l.id; o.textContent = l.code;
                    loc.appendChild(o);
                });
            }
            wh.addEventListener('change', fill);
            fill();
        })();
    </script>
{% endblock %}
