{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ t('stock.transfer_new') }}</h2>
                </div>
                <div class="cx-card__body">
                    <form method="post" action="{{ base_url }}/stock/transfer">
                        <div class="mb-3">
                            <label for="from_warehouse_id" class="form-label">{{ t('stock.transfer_from_warehouse') }}</label>
                            <select id="from_warehouse_id" name="from_warehouse_id" class="form-select" required>
                                <option value="">{{ t('stock.choose_warehouse') }}</option>
                                {% for w in warehouses %}
                                    <option value="{{ w.id }}">{{ w.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="from_location_id" class="form-label">{{ t('stock.transfer_from_location') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                            <select id="from_location_id" name="from_location_id" class="form-select">
                                <option value="">{{ t('stock.no_location') }}</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="to_warehouse_id" class="form-label">{{ t('stock.transfer_to_warehouse') }}</label>
                            <select id="to_warehouse_id" name="to_warehouse_id" class="form-select" required>
                                <option value="">{{ t('stock.choose_warehouse') }}</option>
                                {% for w in warehouses %}
                                    <option value="{{ w.id }}">{{ w.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="to_location_id" class="form-label">{{ t('stock.transfer_to_location') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                            <select id="to_location_id" name="to_location_id" class="form-select">
                                <option value="">{{ t('stock.no_location') }}</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="product_id" class="form-label">{{ t('common.product') }}</label>
                            <select id="product_id" name="product_id" class="form-select cx-ajax-select"
                                    data-url="{{ base_url }}/products/search" data-placeholder="{{ t('common.choose_product') }}" required></select>
                        </div>
                        <div class="mb-3">
                            <label for="quantity" class="form-label">{{ t('common.quantity') }}</label>
                            <input type="number" step="0.001" min="0.001" id="quantity" name="quantity" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label for="note" class="form-label">{{ t('common.note') }}</label>
                            <input type="text" id="note" name="note" class="form-control">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-arrow-left-right me-1"></i>{{ t('stock.transfer_submit') }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ t('stock.transfer_recent') }}</h2>
                </div>
                <div class="cx-card__body p-0">
                    <form method="get" class="p-3 border-bottom">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4 col-lg-3">
                                <label class="form-label small text-muted mb-1">{{ t('common.product') }}</label>
                                <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('stock.product_search_placeholder') }}" value="{{ filters.q }}">
                            </div>
                            <div class="col-sm-3 col-lg-3">
                                <label class="form-label small text-muted mb-1">{{ t('common.warehouse') }}</label>
                                <select name="warehouse_id" class="form-select form-select-sm">
                                    <option value="">{{ t('common.all') }}</option>
                                    {% for w in warehouses %}
                                        <option value="{{ w.id }}" {{ filters.warehouse_id == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-sm-3 col-lg-2">
                                <label class="form-label small text-muted mb-1">{{ t('common.date_from') }}</label>
                                <input type="date" name="date_from" class="form-control form-control-sm" value="{{ filters.date_from }}">
                            </div>
                            <div class="col-sm-3 col-lg-2">
                                <label class="form-label small text-muted mb-1">{{ t('common.date_to') }}</label>
                                <input type="date" name="date_to" class="form-control form-control-sm" value="{{ filters.date_to }}">
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                                <a href="{{ base_url }}/stock/transfer" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 cx-table">
                            <thead>
                            <tr>
                                <th>{{ t('common.date') }}</th>
                                <th>{{ t('stock.direction') }}</th>
                                <th>{{ t('common.warehouse') }}</th>
                                <th>{{ t('stock.location') }}</th>
                                <th>{{ t('common.product') }}</th>
                                <th class="text-end">{{ t('common.quantity') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for m in transfers %}
                                <tr>
                                    <td class="text-muted">{{ m.created_at }}</td>
                                    <td>
                                        {% if m.type == 'out' %}
                                            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('stock.direction_out') }}</span>
                                        {% else %}
                                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('stock.direction_in') }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ m.warehouse_name }}</td>
                                    <td class="text-muted">{{ m.location_code ?: '—' }}</td>
                                    <td>{{ m.sku }} — {{ m.product_name }}</td>
                                    <td class="text-end fw-medium {{ m.type == 'out' ? 'text-danger' : 'text-success' }}">
                                        {{ m.type == 'out' ? '-' : '+' }}{{ m.quantity|qty }} {{ m.unit }}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted py-4">{{ t('stock.transfer_none_found') }}</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% include 'common/pagination.twig' %}
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const locs = {{ locations|json_encode|raw }};
            function bind(whId, locId) {
                const wh = document.getElementById(whId);
                const loc = document.getElementById(locId);
                function fill() {
                    const w = parseInt(wh.value, 10);
                    loc.innerHTML = '<option value="">{{ t('stock.no_location')|e('js') }}</option>';
                    locs.filter(l => l.warehouse_id == w).forEach(l => {
                        const o = document.createElement('option');
                        o.value = l.id; o.textContent = l.code;
                        loc.appendChild(o);
                    });
                }
                wh.addEventListener('change', fill);
                fill();
            }
            bind('from_warehouse_id', 'from_location_id');
            bind('to_warehouse_id', 'to_location_id');
        })();
    </script>
{% endblock %}
