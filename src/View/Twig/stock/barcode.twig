{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 860px;">
        <div class="cx-card__header">
            <h2><i class="bi bi-upc-scan me-2"></i>{{ t('stock.barcode_title') }}</h2>
            <span class="text-muted small">{{ t('stock.barcode_subtitle') }}</span>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/stock/barcode" id="barcode-form">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="warehouse_id" class="form-label">{{ t('common.warehouse') }}</label>
                        <select id="warehouse_id" name="warehouse_id" class="form-select" required>
                            <option value="">{{ t('stock.choose_warehouse') }}</option>
                            {% for w in warehouses %}
                                <option value="{{ w.id }}">{{ w.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="location_id" class="form-label">{{ t('stock.location') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                        <select id="location_id" name="location_id" class="form-select">
                            <option value="">{{ t('stock.no_location') }}</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label d-block">{{ t('stock.direction') }}</label>
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check" name="direction" id="dir-in" value="in" checked>
                            <label class="btn btn-outline-success" for="dir-in"><i class="bi bi-box-arrow-in-down me-1"></i>{{ t('stock.direction_in') }}</label>
                            <input type="radio" class="btn-check" name="direction" id="dir-out" value="out">
                            <label class="btn btn-outline-danger" for="dir-out"><i class="bi bi-box-arrow-up me-1"></i>{{ t('stock.direction_out') }}</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="scan-input" class="form-label">{{ t('stock.barcode_scan_label') }}</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-upc"></i></span>
                        <input type="text" id="scan-input" class="form-control" placeholder="{{ t('stock.barcode_scan_placeholder') }}" autofocus autocomplete="off">
                    </div>
                    <div class="form-text" id="scan-feedback">{{ t('stock.barcode_scan_hint') }}</div>
                </div>

                <div class="table-responsive mb-3">
                    <table class="table cx-table align-middle" id="scan-table">
                        <thead>
                        <tr>
                            <th>{{ t('common.sku') }}</th>
                            <th>{{ t('stock.col_product_name') }}</th>
                            <th style="width: 130px;">{{ t('common.quantity') }}</th>
                            <th style="width: 40px;"></th>
                        </tr>
                        </thead>
                        <tbody id="scan-body">
                        <tr id="scan-empty"><td colspan="4" class="text-center text-muted py-4">{{ t('stock.barcode_empty') }}</td></tr>
                        </tbody>
                    </table>
                </div>

                <button type="submit" class="btn btn-primary" id="scan-submit" disabled>
                    <i class="bi bi-check-lg me-1"></i>{{ t('stock.barcode_submit') }}
                </button>
            </form>
        </div>
    </div>

    {# A vonalkódgyűjtő beállításai (web/assets/js/barcode.js). #}
    <script type="application/json" id="barcode-config">{{ js_data({
        locations: locations,
        no_location: t('stock.no_location'),
        lookup_url: base_url ~ '/stock/barcode/lookup',
        unknown_code: t('stock.barcode_unknown_code'),
        lookup_error: t('stock.barcode_lookup_error')
    }) }}</script>
    <script src="{{ base_url }}/assets/js/barcode.js?v={{ asset_version }}" defer></script>
{% endblock %}
