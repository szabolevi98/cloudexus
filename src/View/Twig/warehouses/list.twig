{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('warehouses.list_title') }}</h2>
            {% if can('warehouses.manage') %}
                <a href="{{ base_url }}/warehouses/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>{{ t('warehouses.new') }}
                </a>
            {% endif %}
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('warehouses.search_placeholder') }}" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{{ t('common.active') }}</option>
                            <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>{{ t('common.inactive') }}</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/warehouses" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th>{{ t('common.name') }}</th>
                        <th>{{ t('warehouses.address') }}</th>
                        <th>{{ t('common.status') }}</th>
                        <th class="text-end">{{ t('common.actions') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for warehouse in warehouses %}
                        <tr>
                            <td class="fw-medium">{{ warehouse.name }}</td>
                            <td class="text-muted">{{ warehouse.address ?: '—' }}</td>
                            <td>
                                {% if warehouse.is_active %}
                                    <span class="badge rounded-pill text-bg-success-subtle text-success-emphasis">{{ t('common.active') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill text-bg-danger-subtle text-danger-emphasis">{{ t('common.inactive') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if can('warehouses.manage') %}
                                    <a href="{{ base_url }}/warehouses/{{ warehouse.id }}/edit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% endif %}
                                {% if can('warehouses.manage') %}
                                    <form method="post" action="{{ base_url }}/warehouses/{{ warehouse.id }}/delete" class="d-inline" onsubmit="return confirm('{{ t('common.confirm_delete')|e('js') }}');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-4">{{ t('warehouses.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
