{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('stocktaking.list_title') }}</h2>
            {% if can('stocktaking.manage') %}
                <a href="{{ base_url }}/stocktaking/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>{{ t('stocktaking.new') }}
                </a>
            {% endif %}
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                {{ sort_inputs() }}
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('stocktaking.search_placeholder') }}" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.warehouse') }}</label>
                        <select name="warehouse_id" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            {% for w in warehouses %}
                                <option value="{{ w.id }}" {{ filters.warehouse_id == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/stocktaking" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th {{ sort_aria('number') }}>{{ sort_link('number', t('stocktaking.col_number')) }}</th>
                        <th {{ sort_aria('warehouse') }}>{{ sort_link('warehouse', t('common.warehouse')) }}</th>
                        <th {{ sort_aria('date') }}>{{ sort_link('date', t('common.date')) }}</th>
                        <th {{ sort_aria('created_by') }}>{{ sort_link('created_by', t('common.created_by')) }}</th>
                        <th class="text-end" {{ sort_aria('items') }}>{{ sort_link('items', t('stocktaking.col_items')) }}</th>
                        <th class="text-end" {{ sort_aria('variances') }}>{{ sort_link('variances', t('stocktaking.col_variances')) }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for s in stocktakings %}
                        <tr>
                            <td class="fw-medium">{{ s.stocktaking_number }}</td>
                            <td>{{ s.warehouse_name }}</td>
                            <td class="text-muted">{{ s.created_at }}</td>
                            <td class="text-muted">{{ s.created_by_name ?: '—' }}</td>
                            <td class="text-end">{{ s.item_count }}</td>
                            <td class="text-end">
                                {% if s.diff_count > 0 %}
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">{{ t('stocktaking.variance_count', {'count': s.diff_count}) }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('stocktaking.accurate') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ base_url }}/stocktaking/{{ s.id }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">{{ t('stocktaking.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
