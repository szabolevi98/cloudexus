{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('stocktaking.new') }}</h2>
        </div>
        <div class="cx-card__body">
            {# 1. lépés: raktárválasztás (GET) #}
            <form method="get" action="{{ base_url }}/stocktaking/create" class="row g-2 align-items-end mb-2">
                <div class="col-sm-5 col-lg-4">
                    <label for="warehouse_id" class="form-label">{{ t('common.warehouse') }}</label>
                    <select id="warehouse_id" name="warehouse_id" class="form-select" data-autosubmit>
                        <option value="">{{ t('stocktaking.choose_warehouse') }}</option>
                        {% for w in warehouses %}
                            <option value="{{ w.id }}" {{ warehouse_id == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-secondary">{{ t('stocktaking.load_sheet') }}</button>
                </div>
            </form>
        </div>

        {% if warehouse_id and sheet %}
            {# 2. lépés: a leltárív kitöltése és könyvelése (POST) #}
            <form method="post" action="{{ base_url }}/stocktaking/create">
                <input type="hidden" name="warehouse_id" value="{{ warehouse_id }}">
                <div class="cx-card__body pt-0">
                    <div class="mb-3">
                        <label for="note" class="form-label">{{ t('common.note') }}</label>
                        <input type="text" id="note" name="note" class="form-control" placeholder="{{ t('stocktaking.note_placeholder') }}">
                    </div>
                    <p class="text-muted small">{{ t('stocktaking.sheet_hint') }}</p>
                </div>
                <div class="table-responsive">
                    <table class="table cx-table align-middle mb-0">
                        <thead>
                        <tr>
                            <th>{{ t('common.sku') }}</th>
                            <th>{{ t('stocktaking.col_name') }}</th>
                            <th class="text-end">{{ t('stocktaking.col_book_quantity') }}</th>
                            <th class="text-end" style="width:160px;">{{ t('stocktaking.col_counted_quantity') }}</th>
                            <th class="text-end" style="width:120px;">{{ t('stocktaking.col_variance') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in sheet %}
                            <tr>
                                <td class="fw-medium">{{ row.sku }}
                                    <input type="hidden" name="product_id[]" value="{{ row.product_id }}">
                                </td>
                                <td>{{ row.product_name }}</td>
                                <td class="text-end cx-book" data-book="{{ row.book_quantity }}">{{ row.book_quantity|qty }} {{ row.unit }}</td>
                                <td class="text-end">
                                    <input type="number" step="0.001" name="counted_quantity[]" class="form-control form-control-sm text-end cx-counted" placeholder="—">
                                </td>
                                <td class="text-end cx-diff text-muted">—</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="cx-card__body d-flex justify-content-between align-items-center">
                    <a href="{{ base_url }}/stocktaking" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ t('stocktaking.submit') }}</button>
                </div>
            </form>
        {% elseif warehouse_id %}
            <div class="cx-card__body text-muted">{{ t('stocktaking.no_products') }}</div>
        {% endif %}
    </div>

{% endblock %}
