{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <div>
                <h2>{{ invoice.invoice_number }}</h2>
                <div class="text-muted small">
                    {{ invoice.partner_name }}
                    {% if invoice.tax_number %} · {{ t('invoices.tax_number') }}: {{ invoice.tax_number }}{% endif %}
                </div>
                {% if invoice.storno_of_id %}
                    <div class="small mt-1"><a href="{{ base_url }}/invoices/{{ invoice.storno_of_id }}">{{ t('invoices.storno_of', {number: invoice.storno_of_number}) }}</a></div>
                {% elseif invoice.storno_by_id %}
                    <div class="small mt-1"><a href="{{ base_url }}/invoices/{{ invoice.storno_by_id }}">{{ t('invoices.stornoed_by', {number: invoice.storno_by_number}) }}</a></div>
                {% endif %}
            </div>
            <div>
                {% include 'common/invoice-status.twig' with {doc: invoice} %}
            </div>
        </div>
        <div class="cx-card__body">
            <div class="row mb-3 g-3">
                <div class="col-md-2">
                    <div class="text-muted small">{{ t('invoices.issue_date_label') }}</div>
                    <div class="fw-medium">{{ invoice.issue_date }}</div>
                </div>
                <div class="col-md-2">
                    <div class="text-muted small">{{ t('invoices.fulfilment_date') }}</div>
                    <div class="fw-medium">{{ invoice.fulfilment_date ?: invoice.issue_date }}</div>
                </div>
                <div class="col-md-2">
                    <div class="text-muted small">{{ t('invoices.due_date') }}</div>
                    <div class="fw-medium">{{ invoice.due_date }}</div>
                </div>
                <div class="col-md-2">
                    <div class="text-muted small">{{ t('invoices.payment_method') }}</div>
                    <div class="fw-medium">{{ t('invoices.payment_methods.' ~ (invoice.payment_method ?: 'transfer')) }}</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">{{ t('invoices.address') }}</div>
                    <div class="fw-medium">{{ invoice.address ?: '—' }}</div>
                </div>
            </div>
        </div>
        <div class="cx-card__body p-0">
            <div class="table-responsive">
                <table class="table cx-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>{{ t('common.sku') }}</th>
                        <th>{{ t('invoices.product_name') }}</th>
                        <th class="text-end">{{ t('common.quantity') }}</th>
                        <th class="text-end">{{ t('invoices.unit_price_net') }}</th>
                        <th class="text-end">{{ t('invoices.vat_rate') }}</th>
                        <th class="text-end">{{ t('invoices.net') }}</th>
                        <th class="text-end">{{ t('invoices.vat') }}</th>
                        <th class="text-end">{{ t('invoices.gross') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in invoice.items %}
                        <tr>
                            <td>{{ item.sku }}</td>
                            <td>{{ item.product_name }}</td>
                            <td class="text-end">{{ item.quantity|qty }} {{ item.unit }}</td>
                            <td class="text-end">{{ item.unit_price|money }}</td>
                            <td class="text-end">{{ item.vat_rate|qty }}%</td>
                            <td class="text-end">{{ (item.net_amount ?? item.line_total)|money }}</td>
                            <td class="text-end">{{ (item.vat_amount ?? 0)|money }}</td>
                            <td class="text-end">{{ (item.gross_amount ?? item.line_total)|money }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    {% if invoice.shipping_cost != 0 %}
                        <tr>
                            <td colspan="5" class="text-end text-muted">{{ t('invoices.shipping_cost_row') }} ({{ invoice.extra_vat_rate|qty }}%)</td>
                            <td class="text-end text-muted">{{ invoice.shipping_cost|money }}</td>
                            <td colspan="2"></td>
                        </tr>
                    {% endif %}
                    {% if invoice.payment_cost != 0 %}
                        <tr>
                            <td colspan="5" class="text-end text-muted">{{ t('invoices.payment_cost_row') }} ({{ invoice.extra_vat_rate|qty }}%)</td>
                            <td class="text-end text-muted">{{ invoice.payment_cost|money }}</td>
                            <td colspan="2"></td>
                        </tr>
                    {% endif %}
                    {% for row in invoice.vat_summary %}
                        <tr>
                            <td colspan="5" class="text-end text-muted">{{ t('invoices.vat_summary') }} · {{ row.rate|qty }}%</td>
                            <td class="text-end text-muted">{{ row.net|money }}</td>
                            <td class="text-end text-muted">{{ row.vat|money }}</td>
                            <td class="text-end text-muted">{{ row.gross|money }}</td>
                        </tr>
                    {% endfor %}
                    <tr>
                        <td colspan="5" class="text-end fw-medium">{{ t('common.total') }}</td>
                        <td class="text-end fw-medium">{{ (invoice.net_total ?? invoice.total_amount)|money }}</td>
                        <td class="text-end fw-medium">{{ (invoice.vat_total ?? 0)|money }}</td>
                        <td class="text-end fw-bold">{{ invoice.total_amount|money }}</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    {% if invoice.invoice_type == 'normal' and invoice.status in ['unpaid', 'paid'] %}
        {% include 'common/payments.twig' with {doc: invoice, payments: payments, base: base_url ~ '/invoices/' ~ invoice.id, payable: invoice.status == 'unpaid'} %}
    {% endif %}

    <div class="d-flex gap-2">
        <a href="{{ base_url }}/invoices" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>{{ t('common.back_to_list') }}
        </a>
        <a href="{{ base_url }}/invoices/{{ invoice.id }}/print" target="_blank" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>{{ t('common.print') }}
        </a>
        {% if invoice.status == 'unpaid' and invoice.invoice_type == 'normal' %}
            {% if can('finance.mark_paid') %}
                <form method="post" action="{{ base_url }}/invoices/{{ invoice.id }}/mark-paid">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>{{ invoice.paid_amount > 0 ? t('payments.settle_rest') : t('invoices.mark_paid') }}
                    </button>
                </form>
            {% endif %}
            {% if can('invoices.storno') and invoice.paid_amount == 0 %}
                <form method="post" action="{{ base_url }}/invoices/{{ invoice.id }}/storno" onsubmit="return confirm('{{ t('invoices.confirm_void')|e('js') }}');">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>{{ t('invoices.void') }}
                    </button>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
