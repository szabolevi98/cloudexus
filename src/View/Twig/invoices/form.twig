{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('invoices.new') }}</h2>
        </div>
        <div class="cx-card__body">
            {% if from_order %}
                <div class="alert alert-info d-flex align-items-center">
                    <i class="bi bi-info-circle me-2"></i>
                    {{ t('invoices.from_order_prefilled', {number: from_order.order_number}) }}
                </div>
            {% endif %}
            <form method="post" action="{{ base_url }}/invoices/create" id="invoice-form">
                {% if from_order %}
                    <input type="hidden" name="order_id" value="{{ from_order.id }}">
                {% endif %}
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('invoices.invoice_number') }}</label>
                        <input type="text" class="form-control" value="{{ invoice_number }}" readonly aria-describedby="invoice-number-hint">
                        <div class="form-text" id="invoice-number-hint">{{ t('invoices.number_on_save') }}</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="partner_id" class="form-label">{{ t('common.partner') }}</label>
                        <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=customer" data-placeholder="{{ t('invoices.choose_partner') }}" required>
                            {% for opt in partner_option|default([]) %}
                                <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                            {% endfor %}
                        </select>
                        {% include 'common/partner-credit.twig' with {due_target: '[name="due_date"]', date_source: '[name="issue_date"]'} %}
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('invoices.issue_date_label') }}</label>
                        <input type="date" name="issue_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('invoices.due_date') }}</label>
                        <input type="date" name="due_date" class="form-control" value="{{ "now"|date_modify("+8 days")|date("Y-m-d") }}">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label" for="fulfilment_date">{{ t('invoices.fulfilment_date') }}</label>
                        <input type="date" id="fulfilment_date" name="fulfilment_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label" for="payment_method">{{ t('invoices.payment_method') }}</label>
                        <select id="payment_method" name="payment_method" class="form-select">
                            {% for method in payment_methods %}
                                <option value="{{ method }}">{{ t('invoices.payment_methods.' ~ method) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="mb-3" style="max-width: 320px;">
                    <label for="warehouse_id" class="form-label">
                        {{ t('invoices.warehouse_stockout') }}
                        <span class="text-muted small">{{ t('common.optional') }}</span>
                    </label>
                    <select id="warehouse_id" name="warehouse_id" class="form-select">
                        <option value="">{{ t('invoices.no_auto_issue') }}</option>
                        {% for w in warehouses %}
                            <option value="{{ w.id }}">{{ w.name }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ t('invoices.warehouse_hint') }}</div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="shipping_cost" class="form-label">{{ t('invoices.shipping_cost', {'currency': currency_symbol()}) }}</label>
                        <input type="number" step="0.01" min="0" id="shipping_cost" name="shipping_cost" class="form-control cx-order-cost" value="{{ from_order.shipping_cost|default(0) }}">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="payment_cost" class="form-label">{{ t('invoices.payment_cost', {'currency': currency_symbol()}) }} <span class="text-muted small">{{ t('invoices.payment_cost_hint') }}</span></label>
                        <input type="number" step="0.01" min="0" id="payment_cost" name="payment_cost" class="form-control cx-order-cost" value="{{ from_order.payment_cost|default(0) }}">
                    </div>
                </div>

                {% include 'common/line-items.twig' with {
                    prefill: from_order ? from_order.items|map(i => {product_id: i.product_id, quantity: i.quantity, unit_price: i.unit_price, text: i.sku ~ ' — ' ~ i.product_name}) : [],
                    partner_select_id: 'partner_id',
                    extra_cost_selector: '.cx-order-cost',
                    date_input_name: 'issue_date'
                } %}

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ base_url }}/invoices" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>{{ t('invoices.create_invoice') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
