{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('invoices.list_title') }}</h2>
            <div class="d-flex gap-2">
                <a href="{{ base_url }}/invoices/export?{{ filters|url_encode }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i>{{ t('common.csv_export') }}
                </a>
                {% if can('invoices.issue') %}
                    <a href="{{ base_url }}/invoices/create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>{{ t('invoices.new') }}
                    </a>
                {% endif %}
            </div>
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                <div class="row g-2 align-items-end">
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('invoices.invoice_number') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="SZLA-…" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.partner') }}</label>
                        <select name="partner_id" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            {% for p in partners %}
                                <option value="{{ p.id }}" {{ filters.partner_id == p.id ? 'selected' : '' }}>{{ p.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="unpaid" {{ filters.status == 'unpaid' ? 'selected' : '' }}>{{ t('common.invoice_status.unpaid') }}</option>
                            <option value="overdue" {{ filters.status == 'overdue' ? 'selected' : '' }}>{{ t('common.invoice_status.overdue') }}</option>
                            <option value="paid" {{ filters.status == 'paid' ? 'selected' : '' }}>{{ t('common.invoice_status.paid') }}</option>
                            <option value="cancelled" {{ filters.status == 'cancelled' ? 'selected' : '' }}>{{ t('common.invoice_status.cancelled') }}</option>
                            <option value="storno" {{ filters.status == 'storno' ? 'selected' : '' }}>{{ t('common.invoice_status.storno') }}</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('invoices.issued_from') }}</label>
                        <input type="date" name="date_from" class="form-control form-control-sm" value="{{ filters.date_from }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('invoices.issued_to') }}</label>
                        <input type="date" name="date_to" class="form-control form-control-sm" value="{{ filters.date_to }}">
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/invoices" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th>{{ t('invoices.invoice_number') }}</th>
                        <th>{{ t('common.partner') }}</th>
                        <th>{{ t('invoices.issue_date') }}</th>
                        <th>{{ t('invoices.due_date') }}</th>
                        <th>{{ t('common.status') }}</th>
                        <th class="text-end">{{ t('common.total') }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set today = "now"|date("Y-m-d") %}
                    {% for invoice in invoices %}
                        <tr>
                            <td class="fw-medium">{{ invoice.invoice_number }}</td>
                            <td>{{ invoice.partner_name }}</td>
                            <td class="text-muted">{{ invoice.issue_date }}</td>
                            <td class="text-muted">{{ invoice.due_date }}</td>
                            <td>
                                {% if invoice.status == 'storno' %}
                                    <span class="badge rounded-pill bg-body-tertiary text-body border">{{ t('invoices.storno_badge') }}</span>
                                {% elseif invoice.status == 'unpaid' and invoice.due_date < today %}
                                    <span class="badge rounded-pill text-bg-danger">{{ t('common.invoice_status.overdue') }}</span>
                                {% elseif invoice.status == 'unpaid' %}
                                    <span class="badge rounded-pill text-bg-warning-subtle text-warning-emphasis">{{ t('common.invoice_status.unpaid') }}</span>
                                {% elseif invoice.status == 'paid' %}
                                    <span class="badge rounded-pill text-bg-success-subtle text-success-emphasis">{{ t('common.invoice_status.paid') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill text-bg-danger-subtle text-danger-emphasis">{{ t('common.invoice_status.cancelled') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">{{ invoice.total_amount|money }}</td>
                            <td class="text-end">
                                <a href="{{ base_url }}/invoices/{{ invoice.id }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">{{ t('invoices.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
