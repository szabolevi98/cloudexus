<!DOCTYPE html>
<html lang="{{ current_locale }}" data-bs-theme="{{ theme_mode == 'dark' ? 'dark' : 'light' }}" data-theme-mode="{{ theme_mode|default('system') }}">
<head>
    <meta charset="UTF-8">
    {% include 'common/theme-head.twig' %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <link rel="icon" href="{{ base_url }}/assets/favicon.svg" type="image/svg+xml">
    <title>{{ page_title ? page_title ~ ' — Cloudexus' : 'Cloudexus' }}</title>
    <link href="{{ base_url }}/assets/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="{{ base_url }}/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ base_url }}/assets/vendor/select2/select2.min.css" rel="stylesheet">
    <link href="{{ base_url }}/assets/vendor/select2/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ base_url }}/assets/css/app.css?v={{ asset_version }}">
</head>
<body data-base="{{ base_url }}">
<div class="cx-shell">
    <div class="cx-backdrop"></div>
    <aside class="cx-sidebar">
        <a class="cx-sidebar__brand" href="{{ base_url }}/dashboard">
            <span class="cx-sidebar__brand-icon"><i class="bi bi-boxes"></i></span>
            <span class="cx-sidebar__brand-text">Cloudexus</span>
        </a>

        <nav class="cx-nav">
            {% if can('dashboard.view') %}
                <a class="cx-nav__link {{ active_menu == 'dashboard' ? 'is-active' : '' }}" href="{{ base_url }}/dashboard">
                    <i class="bi bi-speedometer2"></i><span>{{ t('nav.dashboard') }}</span>
                </a>
            {% endif %}

            {% if can_any('products.view', 'partners.view') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.master_data') }}</div>
                {% if can('products.view') %}
                    <a class="cx-nav__link {{ active_menu == 'products' ? 'is-active' : '' }}" href="{{ base_url }}/products">
                        <i class="bi bi-box-seam"></i><span>{{ t('nav.products') }}</span>
                    </a>
                {% endif %}
                {% if can('products.view') %}
                    <a class="cx-nav__link {{ active_menu == 'categories' ? 'is-active' : '' }}" href="{{ base_url }}/categories">
                        <i class="bi bi-tags"></i><span>{{ t('nav.categories') }}</span>
                    </a>
                {% endif %}
                {% if can('partners.view') %}
                    <a class="cx-nav__link {{ active_menu == 'partners' ? 'is-active' : '' }}" href="{{ base_url }}/partners">
                        <i class="bi bi-people"></i><span>{{ t('nav.partners') }}</span>
                    </a>
                {% endif %}
                {% if can('partners.view') %}
                    <a class="cx-nav__link {{ active_menu == 'customer-groups' ? 'is-active' : '' }}" href="{{ base_url }}/customer-groups">
                        <i class="bi bi-diagram-3"></i><span>{{ t('nav.customer_groups') }}</span>
                    </a>
                {% endif %}
                {% if can('products.view') %}
                    <a class="cx-nav__link {{ active_menu == 'price-rules' ? 'is-active' : '' }}" href="{{ base_url }}/price-rules">
                        <i class="bi bi-percent"></i><span>{{ t('nav.price_rules') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('stock.view', 'stock.move') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.inventory') }}</div>
                {% if can('stock.view') %}
                    <a class="cx-nav__link {{ active_menu == 'warehouses' ? 'is-active' : '' }}" href="{{ base_url }}/warehouses">
                        <i class="bi bi-building"></i><span>{{ t('nav.warehouses') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.view') %}
                    <a class="cx-nav__link {{ active_menu == 'locations' ? 'is-active' : '' }}" href="{{ base_url }}/locations">
                        <i class="bi bi-grid-3x3-gap"></i><span>{{ t('nav.locations') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.view') %}
                    <a class="cx-nav__link {{ active_menu == 'stock-in' ? 'is-active' : '' }}" href="{{ base_url }}/stock/in">
                        <i class="bi bi-box-arrow-in-down"></i><span>{{ t('nav.stock_in') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.view') %}
                    <a class="cx-nav__link {{ active_menu == 'stock-out' ? 'is-active' : '' }}" href="{{ base_url }}/stock/out">
                        <i class="bi bi-box-arrow-up"></i><span>{{ t('nav.stock_out') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.move') %}
                    <a class="cx-nav__link {{ active_menu == 'stock-transfer' ? 'is-active' : '' }}" href="{{ base_url }}/stock/transfer">
                        <i class="bi bi-arrow-left-right"></i><span>{{ t('nav.stock_transfer') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.move') %}
                    <a class="cx-nav__link {{ active_menu == 'stock-barcode' ? 'is-active' : '' }}" href="{{ base_url }}/stock/barcode">
                        <i class="bi bi-upc-scan"></i><span>{{ t('nav.barcode') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.view') %}
                    <a class="cx-nav__link {{ active_menu == 'stocktaking' ? 'is-active' : '' }}" href="{{ base_url }}/stocktaking">
                        <i class="bi bi-clipboard-check"></i><span>{{ t('nav.stocktaking') }}</span>
                    </a>
                {% endif %}
                {% if can('stock.view') %}
                    <a class="cx-nav__link {{ active_menu == 'stock-overview' ? 'is-active' : '' }}" href="{{ base_url }}/stock">
                        <i class="bi bi-bar-chart-steps"></i><span>{{ t('nav.stock_overview') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('orders.view', 'invoices.view') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.sales') }}</div>
                {% if can('orders.view') %}
                    <a class="cx-nav__link {{ active_menu == 'quotes' ? 'is-active' : '' }}" href="{{ base_url }}/quotes">
                        <i class="bi bi-file-earmark-text"></i><span>{{ t('nav.quotes') }}</span>
                    </a>
                    <a class="cx-nav__link {{ active_menu == 'orders' ? 'is-active' : '' }}" href="{{ base_url }}/orders">
                        <i class="bi bi-cart-check"></i><span>{{ t('nav.orders') }}</span>
                    </a>
                {% endif %}
                {% if can('invoices.view') %}
                    <a class="cx-nav__link {{ active_menu == 'invoices' ? 'is-active' : '' }}" href="{{ base_url }}/invoices">
                        <i class="bi bi-receipt"></i><span>{{ t('nav.invoices') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('purchasing.view') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.purchasing') }}</div>
                {% if can('purchasing.view') %}
                    <a class="cx-nav__link {{ active_menu == 'purchase-orders' ? 'is-active' : '' }}" href="{{ base_url }}/purchase-orders">
                        <i class="bi bi-truck"></i><span>{{ t('nav.purchase_orders') }}</span>
                    </a>
                {% endif %}
                {% if can('purchasing.view') %}
                    <a class="cx-nav__link {{ active_menu == 'incoming-invoices' ? 'is-active' : '' }}" href="{{ base_url }}/incoming-invoices">
                        <i class="bi bi-receipt-cutoff"></i><span>{{ t('nav.incoming_invoices') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('cash.view', 'invoices.view', 'purchasing.view') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.cash') }}</div>
                {% if can('cash.view') %}
                    <a class="cx-nav__link {{ active_menu == 'cash' ? 'is-active' : '' }}" href="{{ base_url }}/cash">
                        <i class="bi bi-cash-coin"></i><span>{{ t('nav.cash') }}</span>
                    </a>
                {% endif %}
                {% if can_any('invoices.view', 'purchasing.view') %}
                    <a class="cx-nav__link {{ active_menu == 'aging' ? 'is-active' : '' }}" href="{{ base_url }}/reports/aging">
                        <i class="bi bi-hourglass-split"></i><span>{{ t('nav.aging') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('crm.view') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.crm') }}</div>
                {% if can('crm.view') %}
                    <a class="cx-nav__link {{ active_menu == 'deals' ? 'is-active' : '' }}" href="{{ base_url }}/deals">
                        <i class="bi bi-kanban"></i><span>{{ t('nav.deals') }}</span>
                    </a>
                {% endif %}
                {% if can('crm.view') %}
                    <a class="cx-nav__link {{ active_menu == 'todos' ? 'is-active' : '' }}" href="{{ base_url }}/todos">
                        <i class="bi bi-check2-square"></i><span>{{ t('nav.todos') }}</span>
                    </a>
                    <a class="cx-nav__link {{ active_menu == 'crm_report' ? 'is-active' : '' }}" href="{{ base_url }}/reports/crm">
                        <i class="bi bi-graph-up-arrow"></i><span>{{ t('nav.crm_report') }}</span>
                    </a>
                    <a class="cx-nav__link {{ active_menu == 'dormant' ? 'is-active' : '' }}" href="{{ base_url }}/reports/dormant">
                        <i class="bi bi-moon"></i><span>{{ t('nav.dormant') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('system.users', 'system.roles', 'system.settings', 'catalog.manage', 'system.audit') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.settings') }}</div>
                {% if can('system.users') %}
                    <a class="cx-nav__link {{ active_menu == 'users' ? 'is-active' : '' }}" href="{{ base_url }}/users">
                        <i class="bi bi-person-gear"></i><span>{{ t('nav.users') }}</span>
                    </a>
                {% endif %}
                {% if can('system.roles') %}
                    <a class="cx-nav__link {{ active_menu == 'roles' ? 'is-active' : '' }}" href="{{ base_url }}/roles">
                        <i class="bi bi-shield-lock"></i><span>{{ t('nav.roles') }}</span>
                    </a>
                {% endif %}
                {% if can('system.audit') %}
                    <a class="cx-nav__link {{ active_menu == 'audit' ? 'is-active' : '' }}" href="{{ base_url }}/audit">
                        <i class="bi bi-journal-text"></i><span>{{ t('nav.audit') }}</span>
                    </a>
                {% endif %}
                {% if can('system.settings') %}
                    <a class="cx-nav__link {{ active_menu == 'settings-company' ? 'is-active' : '' }}" href="{{ base_url }}/settings/company">
                        <i class="bi bi-building-gear"></i><span>{{ t('nav.settings_company') }}</span>
                    </a>
                    <a class="cx-nav__link {{ active_menu == 'settings-email' ? 'is-active' : '' }}" href="{{ base_url }}/settings/email">
                        <i class="bi bi-envelope"></i><span>{{ t('nav.settings_email') }}</span>
                        {% set failed_mail = failed_mail_count() %}
                        {% if failed_mail > 0 %}<span class="badge rounded-pill bg-danger ms-auto" title="{{ t('email.state_failed') }}">{{ failed_mail }}</span>{% endif %}
                    </a>
                {% endif %}
                {% if can('catalog.manage') %}
                    <a class="cx-nav__link {{ active_menu == 'parameters' ? 'is-active' : '' }}" href="{{ base_url }}/parameters">
                        <i class="bi bi-sliders"></i><span>{{ t('nav.parameters') }}</span>
                    </a>
                {% endif %}
                {% if can('catalog.manage') %}
                    <a class="cx-nav__link {{ active_menu == 'units' ? 'is-active' : '' }}" href="{{ base_url }}/units">
                        <i class="bi bi-rulers"></i><span>{{ t('nav.units') }}</span>
                    </a>
                {% endif %}
                {% if can('system.settings') %}
                    <a class="cx-nav__link {{ active_menu == 'currencies' ? 'is-active' : '' }}" href="{{ base_url }}/currencies">
                        <i class="bi bi-currency-exchange"></i><span>{{ t('nav.currencies') }}</span>
                    </a>
                {% endif %}
                {% if can('system.settings') %}
                    <a class="cx-nav__link {{ active_menu == 'languages' ? 'is-active' : '' }}" href="{{ base_url }}/languages">
                        <i class="bi bi-translate"></i><span>{{ t('nav.languages') }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {% if can_any('system.api') %}
                <div class="cx-nav__group-label">{{ t('nav.groups.api') }}</div>
                {% if can('system.api') %}
                    <a class="cx-nav__link {{ active_menu == 'api-users' ? 'is-active' : '' }}" href="{{ base_url }}/api-users">
                        <i class="bi bi-key"></i><span>{{ t('nav.api_users') }}</span>
                    </a>
                {% endif %}
                {% if can('system.api') %}
                    <a class="cx-nav__link {{ active_menu == 'api-logs' ? 'is-active' : '' }}" href="{{ base_url }}/api-logs">
                        <i class="bi bi-list-check"></i><span>{{ t('nav.api_logs') }}</span>
                    </a>
                    <a class="cx-nav__link {{ active_menu == 'webhooks' ? 'is-active' : '' }}" href="{{ base_url }}/webhooks">
                        <i class="bi bi-broadcast"></i><span>{{ t('nav.webhooks') }}</span>
                    </a>
                {% endif %}
                {% if can('system.api') %}
                    <a class="cx-nav__link {{ active_menu == 'api-docs' ? 'is-active' : '' }}" href="{{ base_url }}/api-docs">
                        <i class="bi bi-file-earmark-code"></i><span>{{ t('nav.api_docs') }}</span>
                    </a>
                {% endif %}
            {% endif %}
        </nav>

        <p class="cx-sidebar__footer">Copyright &copy; {{ "now"|date("Y") }} <a href="https://github.com/szabolevi98/Cloudexus" target="_blank" rel="noopener">szabolevi98</a></p>
    </aside>
    {# Szinkron, közvetlenül a menü után: a menü görgetése a kirajzolás előtt áll be, nem ugrik. #}
    <script src="{{ base_url }}/assets/js/sidebar-scroll.js?v={{ asset_version }}"></script>

    <div class="cx-main">
        <header class="cx-topbar">
            <button class="cx-topbar__toggle d-lg-none" type="button" aria-label="{{ t('nav.menu') }}">
                <i class="bi bi-list"></i>
            </button>
            <h1 class="cx-topbar__title">{{ page_title|default('') }}</h1>

            <div class="ms-auto d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary cx-palette-btn" data-palette-open title="{{ t('palette.open') }}" aria-label="{{ t('palette.open') }}">
                    <i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-md-inline ms-1"><kbd>Ctrl</kbd> <kbd>K</kbd></span>
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle cx-lang-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ t('nav.language') }}" aria-label="{{ t('nav.language') }}">
                        <i class="bi bi-translate" aria-hidden="true"></i><span class="cx-lang-btn__code ms-1">{{ current_locale|upper }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        {% for lang in languages %}
                            <li>
                                <a class="dropdown-item {{ lang.code == current_locale ? 'active' : '' }}" href="{{ base_url }}/lang/{{ lang.code }}">
                                    {{ lang.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                {# Világos vagy sötét egy kattintással; a "rendszer szerint" a profilban
                   választható. Hogy most melyik látszik, azt rendszer szerinti
                   választásnál csak a böngésző tudja: a szkript tölti ki (app.js). #}
                {% set theme_dark = theme_mode == 'dark' %}
                <form method="post" action="{{ base_url }}/theme/toggle" class="cx-theme-switch" data-theme-switch
                      data-shown="{{ theme_dark ? 'dark' : 'light' }}"
                      data-to-dark="{{ t('nav.theme_to_dark') }}" data-to-light="{{ t('nav.theme_to_light') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <input type="hidden" name="to" value="{{ theme_dark ? 'light' : 'dark' }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary cx-theme-btn"
                            title="{{ theme_dark ? t('nav.theme_to_light') : t('nav.theme_to_dark') }}"
                            aria-label="{{ theme_dark ? t('nav.theme_to_light') : t('nav.theme_to_dark') }}">
                        <i class="bi bi-moon-stars cx-theme-btn__moon" aria-hidden="true"></i>
                        <i class="bi bi-sun cx-theme-btn__sun" aria-hidden="true"></i>
                    </button>
                </form>

                {% if auth_user_id %}
                    <div class="dropdown">
                        <button class="cx-user-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ auth_user_name }}">
                            <span class="cx-user-pill__avatar">{{ auth_user_name|slice(0, 1)|upper }}</span>
                            <span class="cx-user-pill__name">{{ auth_user_name }}</span>
                            <i class="bi bi-chevron-down cx-user-pill__caret" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            {% if auth_role_name %}
                                <li><span class="dropdown-item-text small text-muted"><i class="bi bi-shield-check me-2"></i>{{ auth_role_name }}</span></li>
                                <li><hr class="dropdown-divider"></li>
                            {% endif %}
                            <li><a class="dropdown-item" href="{{ base_url }}/profile"><i class="bi bi-person me-2"></i>{{ t('nav.profile') }}</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{{ base_url }}/logout">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>{{ t('nav.logout') }}</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </header>

        <main class="cx-content">
            {% set undo = undo_offer() %}
            {% if undo %}
                <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2 shadow-sm" role="status" id="undo-offer">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>{{ t('undo.offer', {what: undo.label}) }}</span>
                    <form method="post" action="{{ base_url }}/undo/{{ undo.token }}" class="ms-auto">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">{{ t('undo.button') }}</button>
                    </form>
                </div>
            {% endif %}
            {% for type, message in flashes|default([]) %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : 'success' }} d-flex align-items-center shadow-sm" role="alert">
                    <i class="bi {{ type == 'error' ? 'bi-exclamation-triangle' : 'bi-check-circle' }} me-2"></i>
                    {{ message }}
                </div>
            {% endfor %}

            {% block content %}{% endblock %}
        </main>
    </div>
</div>

<script src="{{ base_url }}/assets/vendor/jquery/jquery.min.js"></script>
<script src="{{ base_url }}/assets/vendor/select2/select2.min.js"></script>
<script src="{{ base_url }}/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>
{# A közös script szövegei — egy nem futtatható JSON-blokk, a CSP script-src 'self' mellett is olvasható. #}
<script type="application/json" id="cx-i18n">{{ js_data({select2: {error_loading: t('select2.error_loading'), input_too_long_one: t('select2.input_too_long_one'), input_too_long_other: t('select2.input_too_long_other'), input_too_short: t('select2.input_too_short'), loading_more: t('select2.loading_more'), maximum_selected_one: t('select2.maximum_selected_one'), maximum_selected_other: t('select2.maximum_selected_other'), no_results: t('select2.no_results'), searching: t('select2.searching'), remove_all_items: t('select2.remove_all_items'), remove_item: t('select2.remove_item'), search: t('select2.search')}, choose_placeholder: t('common.choose_placeholder'), search_placeholder: t('common.search_placeholder')}) }}</script>
<script src="{{ base_url }}/assets/js/app.js?v={{ asset_version }}"></script>
<script src="{{ base_url }}/assets/js/pages.js?v={{ asset_version }}" defer></script>
<dialog class="cx-palette" id="cx-palette" aria-label="{{ t('palette.open') }}"
        data-url="{{ base_url }}/palette" data-nothing="{{ t('palette.nothing') }}">
    <input type="search" class="cx-palette__input" data-palette-input placeholder="{{ t('palette.placeholder') }}" aria-label="{{ t('palette.placeholder') }}" autocomplete="off">
    <ul class="cx-palette__list" data-palette-list role="listbox"></ul>
    <div class="cx-palette__foot">{{ t('palette.keys') }}</div>
</dialog>
<script src="{{ base_url }}/assets/js/palette.js?v={{ asset_version }}"></script>
<script src="{{ base_url }}/assets/js/bulk.js?v={{ asset_version }}"></script>
</body>
</html>
