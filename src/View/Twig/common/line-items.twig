<div class="cx-line-items">
    <label class="form-label">{{ t('common.line_items') }}</label>
    <div class="table-responsive">
        <table class="table cx-table align-middle" id="line-items-table">
            <thead>
            <tr>
                <th>{{ t('common.product') }}</th>
                <th style="width:120px;">{{ t('common.quantity') }}</th>
                <th style="width:150px;">{{ t('common.net_unit_price_ft', {'currency': currency_symbol()}) }}</th>
                <th style="width:150px;" class="text-end">{{ t('common.net_line_total') }}</th>
                <th style="width:40px;"></th>
            </tr>
            </thead>
            <tbody id="line-items-body"></tbody>
            <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-medium">{{ t('common.net_total') }}</td>
                <td class="text-end fw-bold" id="line-items-total">0 {{ currency_symbol() }}</td>
                <td></td>
            </tr>
            </tfoot>
        </table>
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" id="add-line-item">
        <i class="bi bi-plus-lg me-1"></i>{{ t('common.add_line_item') }}
    </button>
</div>

<template id="line-item-template">
    <tr class="cx-line-item">
        <td>
            <select name="product_id[]" class="form-select form-select-sm cx-line-item__product cx-ajax-select"
                    data-url="{{ base_url }}/products/search" data-placeholder="{{ t('common.choose_product') }}" required></select>
        </td>
        <td><input type="number" step="0.001" min="0.001" name="quantity[]" class="form-control form-control-sm cx-line-item__quantity" required></td>
        <td>
            <input type="number" step="0.01" min="0" name="unit_price[]" class="form-control form-control-sm cx-line-item__price" required>
            <div class="form-text small text-success cx-line-item__rule" hidden></div>
        </td>
        <td class="text-end cx-line-item__total">0 {{ currency_symbol() }}</td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-outline-danger cx-line-item__remove">
                <i class="bi bi-x-lg"></i>
            </button>
        </td>
    </tr>
</template>

{# A sorok scriptjének beállításai (web/assets/js/line-items.js). #}
<script type="application/json" id="line-items-config">{{ js_data({
    prefill: prefill|default([]),
    partner_select_id: partner_select_id|default(null),
    extra_cost_selector: extra_cost_selector|default(null),
    date_input_name: date_input_name|default(null),
    rule_label: t('price_rules.applied'),
    currency: currency_symbol(),
    pricing_url: base_url ~ '/pricing/effective'
}) }}</script>
<script src="{{ base_url }}/assets/js/line-items.js?v={{ asset_version }}" defer></script>
