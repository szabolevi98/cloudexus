<!DOCTYPE html>
<html lang="{{ current_locale }}" data-bs-theme="{{ theme_mode == 'dark' ? 'dark' : 'light' }}" data-theme-mode="{{ theme_mode|default('system') }}">
<head>
    <meta charset="UTF-8">
    {% include 'common/theme-head.twig' %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('auth.page_title') }}{% endblock %} — Cloudexus</title>
    <link rel="icon" href="{{ base_url }}/assets/favicon.svg" type="image/svg+xml">
    <link href="{{ base_url }}/assets/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="{{ base_url }}/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ base_url }}/assets/css/app.css?v={{ asset_version }}">
</head>
<body class="cx-auth-body">
<div class="cx-auth-decor"></div>
<div class="cx-auth-wrap">
<div class="cx-auth-card">
    <details class="cx-auth-lang">
        <summary class="cx-auth-lang__toggle" role="button" aria-label="{{ t('nav.language') }}" title="{{ t('nav.language') }}">
            <i class="bi bi-translate" aria-hidden="true"></i>
        </summary>
        <div class="cx-auth-lang__menu">
            {% for lang in languages %}
                <a class="cx-auth-lang__item {{ lang.code == current_locale ? 'is-active' : '' }}" href="{{ base_url }}/lang/{{ lang.code }}" {{ lang.code == current_locale ? 'aria-current="true"' : '' }}>
                    {{ lang.name }}
                    {% if lang.code == current_locale %}<i class="bi bi-check2" aria-hidden="true"></i>{% endif %}
                </a>
            {% endfor %}
        </div>
    </details>

    <div class="cx-auth-card__brand">
        <span class="cx-auth-card__brand-icon"><i class="bi bi-boxes"></i></span>
        <span>Cloudexus</span>
    </div>
    <p class="cx-auth-card__subtitle">{% block subtitle %}{{ t('auth.subtitle') }}{% endblock %}</p>

    {% if error|default(null) %}
        <div class="alert alert-danger d-flex align-items-center py-2" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>{{ error }}
        </div>
    {% endif %}
    {% if notice|default(null) %}
        <div class="alert alert-success d-flex align-items-center py-2" role="status">
            <i class="bi bi-check-circle me-2"></i>{{ notice }}
        </div>
    {% endif %}

    {% block card %}{% endblock %}
</div>
<p class="cx-auth-footer">Copyright &copy; {{ "now"|date("Y") }} <a href="https://github.com/szabolevi98/Cloudexus" target="_blank" rel="noopener">szabolevi98</a></p>
</div>
<script>
    // A <details> alapból nyitva marad külső kattintásra és Escape-re is,
    // ezért ezt a két lezárást pótoljuk (a topbar dropdownja is így viselkedik).
    (function () {
        const lang = document.querySelector('.cx-auth-lang');
        if (!lang) return;

        document.addEventListener('click', function (e) {
            if (lang.open && !lang.contains(e.target)) lang.open = false;
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && lang.open) {
                lang.open = false;
                lang.querySelector('summary').focus();
            }
        });
    })();
</script>
</body>
{#
    reCAPTCHA v3 egy űrlapon, ha be van kapcsolva: az űrlap data-recaptcha
    attribútuma a művelet neve (login, forgot), a tokent a recaptcha_token
    rejtett mezőbe teszi, és csak utána küldi el.
#}
{% if recaptcha_enabled|default(false) %}
    <script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key }}"></script>
    <script>
        (function () {
            const form = document.querySelector('form[data-recaptcha]');
            if (!form) return;
            const submitBtn = form.querySelector('button[type="submit"]');
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                submitBtn.disabled = true;
                grecaptcha.ready(function () {
                    grecaptcha.execute('{{ recaptcha_site_key }}', {action: form.dataset.recaptcha}).then(function (token) {
                        form.querySelector('input[name="recaptcha_token"]').value = token;
                        form.submit();
                    });
                });
            });
        })();
    </script>
{% endif %}
</html>
