{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <div>
                <h2>{{ order.po_number }}</h2>
                <div class="text-muted small">{{ order.partner_name }} · {{ order.order_date }}</div>
            </div>
            <div>
                {% if order.status == 'confirmed' %}
                    <span class="badge rounded-pill text-bg-primary">{{ t('common.order_status.confirmed') }}</span>
                {% elseif order.status == 'invoiced' %}
                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('common.order_status.invoiced') }}</span>
                {% else %}
                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('common.order_status.cancelled') }}</span>
                {% endif %}
            </div>
        </div>
        {# A mobil appban átvett beszerzés (25_picking_and_receiving.sql): a
           készlet már bejött, a bejövő számlája nem veszi be még egyszer. #}
        {% if order.received_at %}
            <div class="cx-card__body border-bottom pt-3 pb-3 small">
                <i class="bi bi-truck me-1"></i>{{ t('purchase_orders.received', {date: order.received_at|date('Y-m-d H:i'), name: order.received_by_name|default('—'), warehouse: order.received_warehouse_name|default('—')}) }}
                <div class="text-muted">{{ t('purchase_orders.received_note') }}</div>
            </div>
        {% endif %}
        <div class="cx-card__body p-0">
            <div class="table-responsive">
                <table class="table cx-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>{{ t('common.sku') }}</th>
                        <th>{{ t('purchase_orders.product_name') }}</th>
                        <th class="text-end">{{ t('common.quantity') }}</th>
                        {% if order.received_at %}<th class="text-end">{{ t('purchase_orders.received_quantity') }}</th>{% endif %}
                        <th class="text-end">{{ t('common.unit_price') }}</th>
                        <th class="text-end">{{ t('common.line_total') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in order.items %}
                        <tr>
                            <td>{{ item.sku }}</td>
                            <td>{{ item.product_name }}</td>
                            <td class="text-end">{{ item.quantity|qty }} {{ item.unit }}</td>
                            {% if order.received_at %}<td class="text-end {{ item.received_quantity < item.quantity ? 'text-warning-emphasis' : '' }}">{{ item.received_quantity|qty }} {{ item.unit }}</td>{% endif %}
                            <td class="text-end">{{ item.unit_price|money }}</td>
                            <td class="text-end">{{ item.line_total|money }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="{{ order.received_at ? 5 : 4 }}" class="text-end fw-medium">{{ t('common.total') }}</td>
                        <td class="text-end fw-bold">{{ order.total_amount|money }}</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ base_url }}/purchase-orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>{{ t('common.back_to_list') }}
        </a>
        {% if order.status == 'confirmed' %}
            {% if can('purchasing.manage') %}
                <a href="{{ base_url }}/incoming-invoices/create?order_id={{ order.id }}" class="btn btn-primary">
                    <i class="bi bi-receipt me-1"></i>{{ t('purchase_orders.make_incoming_invoice') }}
                </a>
            {% endif %}
            {% if can('purchasing.manage') %}
                <form method="post" action="{{ base_url }}/purchase-orders/{{ order.id }}/cancel" data-confirm="{{ t('purchase_orders.confirm_void') }}">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>{{ t('purchase_orders.void') }}
                    </button>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
