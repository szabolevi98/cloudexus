{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ quote ? t('quotes.edit') ~ ': ' ~ quote.quote_number : t('quotes.new') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/quotes/{{ quote ? quote.id : 'create' }}" id="quote-form">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('quotes.number') }}</label>
                        <input type="text" class="form-control" value="{{ number }}" readonly>
                    </div>
                    <div class="col-md-5 mb-3">
                        <label for="partner_id" class="form-label">{{ t('orders.partner_customer') }}</label>
                        <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=customer" data-placeholder="{{ t('orders.choose_partner') }}" required>
                            {% for opt in partner_option|default([]) %}<option value="{{ opt.id }}" selected>{{ opt.text }}</option>{% endfor %}
                        </select>
                        {% include 'common/partner-credit.twig' %}
                    </div>
                    <div class="col-md-2 mb-3">
                        <label for="quote_date" class="form-label">{{ t('common.date') }}</label>
                        <input type="date" id="quote_date" name="quote_date" class="form-control" value="{{ quote ? quote.quote_date : 'now'|date('Y-m-d') }}">
                    </div>
                    <div class="col-md-2 mb-3">
                        <label for="valid_until" class="form-label">{{ t('quotes.valid_until') }}</label>
                        <input type="date" id="valid_until" name="valid_until" class="form-control" value="{{ valid_until }}">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="shipping_cost" class="form-label">{{ t('orders.shipping_cost', {'currency': currency_symbol()}) }}</label>
                        <input type="number" step="0.01" min="0" id="shipping_cost" name="shipping_cost" class="form-control cx-order-cost" value="{{ quote.shipping_cost|default(0) }}">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="payment_cost" class="form-label">{{ t('orders.payment_cost', {'currency': currency_symbol()}) }}</label>
                        <input type="number" step="0.01" min="0" id="payment_cost" name="payment_cost" class="form-control cx-order-cost" value="{{ quote.payment_cost|default(0) }}">
                    </div>
                </div>

                {% include 'common/line-items.twig' with {partner_select_id: 'partner_id', extra_cost_selector: '.cx-order-cost', date_input_name: 'quote_date', prefill: prefill} %}

                <div class="mt-3">
                    <label for="note" class="form-label">{{ t('quotes.note') }} <span class="text-muted small">{{ t('quotes.note_hint') }}</span></label>
                    <textarea id="note" name="note" class="form-control" rows="3" maxlength="4000">{{ quote.note|default('') }}</textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ base_url }}/quotes{{ quote ? '/' ~ quote.id : '' }}" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ quote ? t('common.save') : t('quotes.create') }}</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
