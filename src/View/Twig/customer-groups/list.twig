{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3">
        {% if can('customer_groups.manage') %}
            <div class="col-lg-4">
                <div class="cx-card">
                    <div class="cx-card__header"><h2>{{ t('customer_groups.new') }}</h2></div>
                    <div class="cx-card__body">
                        <form method="post" action="{{ base_url }}/customer-groups/create">
                            <div class="mb-3">
                                <label for="name" class="form-label">{{ t('common.name') }}</label>
                                <input type="text" id="name" name="name" class="form-control" placeholder="{{ t('customer_groups.name_placeholder') }}" required>
                            </div>
                            <div class="mb-3">
                                <label for="description" class="form-label">{{ t('customer_groups.description') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                                <input type="text" id="description" name="description" class="form-control">
                            </div>
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>{{ t('common.add') }}</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
        <div class="{{ can('customer_groups.manage') ? 'col-lg-8' : 'col-12' }}">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ t('customer_groups.list_title') }}</h2>
                    <span class="text-muted small">{{ pager.total }} {{ t('common.pcs') }}</span>
                </div>
                <div class="cx-card__body p-0">
                    <form method="get" class="p-3 border-bottom">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-6 col-lg-4">
                                <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                                <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('customer_groups.search_placeholder') }}" value="{{ filters.q }}">
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                                <a href="{{ base_url }}/customer-groups" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 cx-table">
                            <thead><tr><th>{{ t('common.name') }}</th><th>{{ t('customer_groups.description') }}</th><th class="text-end">{{ t('customer_groups.partners') }}</th><th class="text-end">{{ t('common.actions') }}</th></tr></thead>
                            <tbody>
                            {% for g in groups %}
                                <tr>
                                    <td>{% if can('customer_groups.manage') %}<input type="text" name="name" form="cg-{{ g.id }}" class="form-control form-control-sm" value="{{ g.name }}">{% else %}<span class="fw-medium">{{ g.name }}</span>{% endif %}</td>
                                    <td>{% if can('customer_groups.manage') %}<input type="text" name="description" form="cg-{{ g.id }}" class="form-control form-control-sm" value="{{ g.description }}">{% else %}<span class="text-muted">{{ g.description ?: '—' }}</span>{% endif %}</td>
                                    <td class="text-end text-muted">
                                        <a href="{{ base_url }}/partners?customer_group_id={{ g.id }}">{{ g.partner_count }} {{ t('common.pcs') }}</a>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        {% if can('customer_groups.manage') %}
                                            <button type="submit" form="cg-{{ g.id }}" class="btn btn-sm btn-outline-primary">{{ t('common.save') }}</button>
                                            <button type="submit" form="cg-del-{{ g.id }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('{{ t('common.confirm_delete')|e('js') }}');"><i class="bi bi-trash"></i></button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-center text-muted py-4">{{ t('customer_groups.none_found') }}</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% include 'common/pagination.twig' %}
                </div>
            </div>
        </div>
    </div>

    {% for g in groups %}
        <form id="cg-{{ g.id }}" method="post" action="{{ base_url }}/customer-groups/{{ g.id }}"></form>
        <form id="cg-del-{{ g.id }}" method="post" action="{{ base_url }}/customer-groups/{{ g.id }}/delete"></form>
    {% endfor %}
{% endblock %}
