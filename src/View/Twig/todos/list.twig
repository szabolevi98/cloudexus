{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3">
        {% if can('crm.manage') %}
            <div class="col-lg-4">
                <div class="cx-card">
                    <div class="cx-card__header"><h2>{{ t('todos.new') }}</h2></div>
                    <div class="cx-card__body">
                        <form method="post" action="{{ base_url }}/todos/create" id="todo-form">
                            {% include 'todos/_fields.twig' with {todo: prefill} %}
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>{{ t('common.add') }}</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
        <div class="{{ can('crm.manage') ? 'col-lg-8' : 'col-12' }}">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ t('todos.list_title') }}</h2>
                    <a href="{{ base_url }}/todos/week" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar-week me-1"></i>{{ t('todos.week_title') }}</a>
                </div>
                <div class="cx-card__body p-0">
                    <form method="get" class="p-3 border-bottom">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label small text-muted mb-1" for="filter-q">{{ t('common.search') }}</label>
                                <input type="text" id="filter-q" name="q" class="form-control form-control-sm" value="{{ filters.q }}">
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label small text-muted mb-1" for="filter-type">{{ t('todos.type_label') }}</label>
                                <select id="filter-type" name="type" class="form-select form-select-sm">
                                    <option value="">{{ t('todos.all') }}</option>
                                    {% for type, icon in form.types %}
                                        <option value="{{ type }}" {{ filters.type == type ? 'selected' : '' }}>{{ t('todos.type.' ~ type) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label small text-muted mb-1" for="filter-status">{{ t('todos.status') }}</label>
                                <select id="filter-status" name="status" class="form-select form-select-sm">
                                    <option value="">{{ t('todos.all') }}</option>
                                    <option value="open" {{ filters.status == 'open' ? 'selected' : '' }}>{{ t('todos.open') }}</option>
                                    <option value="done" {{ filters.status == 'done' ? 'selected' : '' }}>{{ t('todos.done') }}</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 cx-table" id="todo-list">
                            <tbody>
                            {% for todo in todos %}
                                {% include 'todos/_row.twig' with {return: '/todos?' ~ filters|url_encode} %}
                            {% else %}
                                <tr><td class="text-center text-muted py-4">{{ t('todos.none_found') }}</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% include 'common/pagination.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
