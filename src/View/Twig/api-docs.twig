{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('api_users.docs_title') }}</h2>
            <a href="{{ base_url }}/API.md" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-filetype-md me-1"></i>{{ t('api_users.docs_open_raw') }}
            </a>
        </div>
        <div class="cx-card__body">
            <p class="text-muted">{{ t('api_users.docs_english_only') }}</p>
            <div id="markdown-content" class="markdown-body" data-src="{{ base_url }}/API.md" data-error="{{ t('api_users.docs_load_failed') }}">
                <p class="text-muted">{{ t('api_users.docs_loading') }}</p>
            </div>
        </div>
    </div>

    <script src="{{ base_url }}/assets/vendor/marked/marked.min.js"></script>
{% endblock %}
