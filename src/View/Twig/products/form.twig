{% extends 'common/layout.twig' %}

{% block content %}
    <form method="post" action="{{ base_url }}/products{{ product ? '/' ~ product.id : '/create' }}" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="col-lg-8">
                {# --- Alapadatok --- #}
                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ product ? t('products.edit_title') : t('products.new') }}</h2></div>
                    <div class="cx-card__body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="sku" class="form-label">{{ t('products.sku') }} *</label>
                                <input type="text" id="sku" name="sku" class="form-control" value="{{ product.sku|default('') }}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="barcode" class="form-label">{{ t('products.barcode') }} <span class="text-muted small">{{ t('products.barcode_hint') }}</span></label>
                                <input type="text" id="barcode" name="barcode" class="form-control" value="{{ product.barcode|default('') }}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="unit_id" class="form-label">{{ t('products.unit') }}</label>
                                <select id="unit_id" name="unit_id" class="form-select cx-select2">
                                    <option value="">{{ t('common.choose') }}</option>
                                    {% for u in units %}
                                        <option value="{{ u.id }}" {{ product.unit_id|default(null) == u.id ? 'selected' : '' }}>{{ u.name }} ({{ u.code }})</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {# Nyelvenkénti fülek: a név és a leírások nyelvenként tárolódnak.
                           A kötelező kitöltés csak az alapnyelvre (az első fülre) vonatkozik. #}
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            {% for lang in languages %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link {{ loop.first ? 'active' : '' }}" type="button"
                                            data-bs-toggle="tab" data-bs-target="#prod-lang-{{ lang.id }}"
                                            role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ lang.name }}</button>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="tab-content">
                            {% for lang in languages %}
                                <div class="tab-pane fade {{ loop.first ? 'show active' : '' }}" id="prod-lang-{{ lang.id }}" role="tabpanel">
                                    <div class="mb-3">
                                        <label for="name-{{ lang.id }}" class="form-label">{{ t('products.name') }}{{ loop.first ? ' *' : '' }}</label>
                                        <input type="text" id="name-{{ lang.id }}" name="name[{{ lang.id }}]" class="form-control"
                                               value="{{ descriptions[lang.id].name|default('') }}" {{ loop.first ? 'required' : '' }}>
                                    </div>
                                    <div class="mb-3">
                                        <label for="short_description-{{ lang.id }}" class="form-label">{{ t('products.short_description') }}</label>
                                        <input type="text" id="short_description-{{ lang.id }}" name="short_description[{{ lang.id }}]"
                                               class="form-control" maxlength="255" value="{{ descriptions[lang.id].short_description|default('') }}">
                                    </div>
                                    <div class="mb-1">
                                        <label for="description-{{ lang.id }}" class="form-label">{{ t('products.long_description') }}</label>
                                        <textarea id="description-{{ lang.id }}" name="description[{{ lang.id }}]" class="tinymce-editor form-control" rows="8">{{ descriptions[lang.id].description|default('') }}</textarea>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# --- Paraméterek --- #}
                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('products.parameters') }}</h2></div>
                    <div class="cx-card__body">
                        <div id="attr-rows">
                            {% for row in parameter_rows|default([]) %}
                                <div class="row g-2 mb-2 attr-row">
                                    <div class="col-md-5">
                                        <select name="parameter_id[]" class="form-select form-select-sm cx-ajax-select" data-url="{{ base_url }}/parameters/search" data-placeholder="{{ t('products.param_name_placeholder') }}">
                                            <option value="{{ row.parameter_id }}" selected>{{ row.name }}</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        {% for lang in languages %}
                                            <div class="input-group input-group-sm {{ not loop.last ? 'mb-1' : '' }}">
                                                <span class="input-group-text" title="{{ lang.name }}">{{ lang.code|upper }}</span>
                                                <input type="text" name="parameter_value[{{ lang.id }}][]" class="form-control"
                                                       placeholder="{{ t('products.value_placeholder') }}"
                                                       value="{{ row.values[lang.id]|default('') }}">
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger attr-remove"><i class="bi bi-x-lg"></i></button></div>
                                </div>
                            {% endfor %}
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="attr-add"><i class="bi bi-plus-lg me-1"></i>{{ t('products.add_parameter') }}</button>
                        <template id="attr-template">
                            <div class="row g-2 mb-2 attr-row">
                                <div class="col-md-5">
                                    <select name="parameter_id[]" class="form-select form-select-sm cx-ajax-select" data-url="{{ base_url }}/parameters/search" data-placeholder="{{ t('products.param_name_placeholder') }}"></select>
                                </div>
                                <div class="col-md-6">
                                    {% for lang in languages %}
                                        <div class="input-group input-group-sm {{ not loop.last ? 'mb-1' : '' }}">
                                            <span class="input-group-text" title="{{ lang.name }}">{{ lang.code|upper }}</span>
                                            <input type="text" name="parameter_value[{{ lang.id }}][]" class="form-control"
                                                   placeholder="{{ t('products.value_placeholder') }}">
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger attr-remove"><i class="bi bi-x-lg"></i></button></div>
                            </div>
                        </template>
                    </div>
                </div>

                {# --- Kapcsolódó / helyettesítő termékek --- #}
                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('products.related_and_substitute') }}</h2></div>
                    <div class="cx-card__body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="related_ids" class="form-label">{{ t('products.related') }}</label>
                                <select id="related_ids" name="related_ids[]" class="form-select cx-ajax-select" data-url="{{ base_url }}/products/search" data-placeholder="{{ t('products.product_search_placeholder') }}" multiple>
                                    {% for opt in related_options %}
                                        <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="substitute_ids" class="form-label">{{ t('products.substitute') }}</label>
                                <select id="substitute_ids" name="substitute_ids[]" class="form-select cx-ajax-select" data-url="{{ base_url }}/products/search" data-placeholder="{{ t('products.product_search_placeholder') }}" multiple>
                                    {% for opt in substitute_options %}
                                        <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                {# --- Vevőcsoport árak --- #}
                {% if customer_groups %}
                    <div class="cx-card mb-3">
                        <div class="cx-card__header"><h2>{{ t('products.group_prices') }}</h2></div>
                        <div class="cx-card__body">
                            <div class="form-text mb-2">{{ t('products.group_prices_hint') }}</div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                    <tr>
                                        <th>{{ t('products.group') }}</th>
                                        <th>{{ t('products.fixed_price', {'currency': currency_symbol()}) }}</th>
                                        <th>{{ t('products.sale_price_col', {'currency': currency_symbol()}) }}</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for g in customer_groups %}
                                        {% set gp = product.group_prices[g.id]|default(null) %}
                                        <tr>
                                            <td>
                                                {{ g.name }}
                                                <input type="hidden" name="group_id[]" value="{{ g.id }}">
                                            </td>
                                            <td><input type="number" step="0.01" min="0" name="group_price[]" class="form-control form-control-sm" value="{{ gp.price|default('') }}"></td>
                                            <td><input type="number" step="0.01" min="0" name="group_sale_price[]" class="form-control form-control-sm" value="{{ gp.sale_price|default('') }}"></td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# --- Képek --- #}
                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('products.images') }}</h2></div>
                    <div class="cx-card__body">
                        {% if product and product.images %}
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                {% for img in product.images %}
                                    <div class="cx-product-thumb {{ img.is_primary ? 'is-primary' : '' }}">
                                        <img src="{{ img.path starts with 'http' ? img.path : base_url ~ '/' ~ img.path }}" alt="">
                                        <div class="cx-product-thumb__actions">
                                            {% if not img.is_primary %}
                                                <button type="submit" form="img-primary-{{ img.id }}" class="btn btn-sm btn-light" title="{{ t('products.primary') }}"><i class="bi bi-star"></i></button>
                                            {% else %}
                                                <span class="badge text-bg-primary">{{ t('products.primary') }}</span>
                                            {% endif %}
                                            <button type="submit" form="img-del-{{ img.id }}" class="btn btn-sm btn-danger" title="{{ t('common.delete') }}" onclick="return confirm('{{ t('products.confirm_delete_image')|e('js') }}');"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="images" class="form-label">{{ t('products.image_upload') }} <span class="text-muted small">{{ t('products.multiple') }}</span></label>
                                <input type="file" id="images" name="images[]" class="form-control" accept="image/*" multiple>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label for="image_url" class="form-label">{{ t('products.image_from_url') }}</label>
                                <input type="url" id="image_url" name="image_url" class="form-control" placeholder="https://…">
                            </div>
                        </div>
                        {% if not product %}
                            <div class="form-text">{{ t('products.images_after_save') }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# --- Oldalsáv: besorolás, árazás, méretek, státusz --- #}
            <div class="col-lg-4">
                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('products.classification') }}</h2></div>
                    <div class="cx-card__body">
                        <label for="category_ids" class="form-label">{{ t('products.categories') }}</label>
                        <select id="category_ids" name="category_ids[]" class="form-select cx-ajax-select" data-url="{{ base_url }}/categories/search" data-placeholder="{{ t('products.category_search_placeholder') }}" multiple>
                            {% for opt in category_options %}
                                <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">{{ t('products.multi_category_hint') }}</div>
                    </div>
                </div>

                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('products.pricing_stock') }}</h2></div>
                    <div class="cx-card__body">
                        <div class="row">
                            <div class="col-8 mb-3">
                                <label for="price" class="form-label">{{ t('products.net_price', {'currency': currency_symbol()}) }}</label>
                                <input type="number" step="0.01" id="price" name="price" class="form-control" value="{{ product.price|default(0) }}">
                            </div>
                            <div class="col-4 mb-3">
                                <label for="vat_rate" class="form-label">{{ t('products.vat') }}</label>
                                <input type="number" step="0.01" id="vat_rate" name="vat_rate" class="form-control" value="{{ product.vat_rate|default(27) }}">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="sale_price" class="form-label">{{ t('products.sale_price', {'currency': currency_symbol()}) }} <span class="text-muted small">{{ t('products.sale_price_hint') }}</span></label>
                            <input type="number" step="0.01" min="0" id="sale_price" name="sale_price" class="form-control" value="{{ product.sale_price|default('') }}">
                        </div>
                        {% if product %}
                            <div class="alert alert-secondary d-flex justify-content-between align-items-center py-2 mb-3">
                                <span class="small">{{ t('products.current_stock') }}</span>
                                <span class="fw-bold">{{ product.stock_qty|number_format(0, ',', ' ') }} {{ product.unit }}</span>
                            </div>
                        {% endif %}
                        <div class="mb-1">
                            <label for="min_stock" class="form-label">{{ t('products.min_stock') }} <span class="text-muted small">{{ t('products.min_stock_hint') }}</span></label>
                            <input type="number" step="0.001" min="0" id="min_stock" name="min_stock" class="form-control" value="{{ product.min_stock|default(0) }}">
                        </div>
                        {% if not product %}
                            <hr>
                            <div class="mb-2">
                                <label for="opening_stock" class="form-label">{{ t('products.opening_stock') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                                <input type="number" step="0.001" min="0" id="opening_stock" name="opening_stock" class="form-control">
                            </div>
                            <div class="mb-1">
                                <label for="opening_warehouse_id" class="form-label">{{ t('products.opening_warehouse') }}</label>
                                <select id="opening_warehouse_id" name="opening_warehouse_id" class="form-select">
                                    <option value="">{{ t('common.choose') }}</option>
                                    {% for w in warehouses %}
                                        <option value="{{ w.id }}">{{ w.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('products.dimensions') }}</h2></div>
                    <div class="cx-card__body">
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="width_mm" class="form-label">{{ t('products.width') }}</label>
                                <input type="number" min="0" id="width_mm" name="width_mm" class="form-control" value="{{ product.width_mm|default('') }}">
                            </div>
                            <div class="col-6 mb-3">
                                <label for="height_mm" class="form-label">{{ t('products.height') }}</label>
                                <input type="number" min="0" id="height_mm" name="height_mm" class="form-control" value="{{ product.height_mm|default('') }}">
                            </div>
                            <div class="col-6 mb-1">
                                <label for="depth_mm" class="form-label">{{ t('products.depth') }}</label>
                                <input type="number" min="0" id="depth_mm" name="depth_mm" class="form-control" value="{{ product.depth_mm|default('') }}">
                            </div>
                            <div class="col-6 mb-1">
                                <label for="weight_g" class="form-label">{{ t('products.weight') }}</label>
                                <input type="number" min="0" id="weight_g" name="weight_g" class="form-control" value="{{ product.weight_g|default('') }}">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cx-card mb-3">
                    <div class="cx-card__header"><h2>{{ t('common.status') }}</h2></div>
                    <div class="cx-card__body">
                        <div class="form-check form-switch mb-2">
                            <input type="checkbox" id="is_active" name="is_active" class="form-check-input" {{ (product is null or product.is_active) ? 'checked' : '' }}>
                            <label for="is_active" class="form-check-label">{{ t('common.active') }}</label>
                        </div>
                        <div class="form-check form-switch">
                            <input type="checkbox" id="is_webshop" name="is_webshop" class="form-check-input" {{ (product is null or product.is_webshop) ? 'checked' : '' }}>
                            <label for="is_webshop" class="form-check-label">{{ t('products.is_webshop') }}</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mb-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>{{ t('common.save') }}</button>
            <a href="{{ base_url }}/products" class="btn btn-outline-secondary">{{ t('common.back_to_list') }}</a>
        </div>
    </form>

    {# Külön kis formok a kép-műveletekhez (a fő űrlapon kívül, hogy ne ütközzenek) #}
    {% if product %}
        {% for img in product.images %}
            <form id="img-del-{{ img.id }}" method="post" action="{{ base_url }}/products/{{ product.id }}/images/{{ img.id }}/delete"></form>
            <form id="img-primary-{{ img.id }}" method="post" action="{{ base_url }}/products/{{ product.id }}/images/{{ img.id }}/primary"></form>
        {% endfor %}
    {% endif %}

    <script src="{{ base_url }}/assets/vendor/tinymce/tinymce.min.js"></script>
    <script>
        (function () {
            if (typeof tinymce === 'undefined') return;
            tinymce.init({
                selector: 'textarea.tinymce-editor',
                base_url: '{{ base_url }}/assets/vendor/tinymce',
                suffix: '.min',
                height: 320,
                menubar: false,
                branding: false,
                plugins: 'advlist autolink lists link image charmap preview anchor searchreplace visualblocks code fullscreen insertdatetime media table paste help wordcount',
                toolbar: 'undo redo | styleselect | bold italic | bullist numlist outdent indent | link image table | removeformat code fullscreen',
                skin: window.cxDark() ? 'oxide-dark' : 'oxide',
                content_style: 'body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:14px}'
                    + (window.cxDark() ? 'body{background:#12162a;color:#e3e6f1}a{color:#9aa3f6}' : ''),
            });
        })();

        (function () {
            const rows = document.getElementById('attr-rows');
            const tpl = document.getElementById('attr-template');
            document.getElementById('attr-add').addEventListener('click', () => {
                const row = tpl.content.firstElementChild.cloneNode(true);
                rows.appendChild(row);
                if (window.cxInitSelect2) window.cxInitSelect2(row);
            });
            rows.addEventListener('click', (e) => {
                if (e.target.closest('.attr-remove')) e.target.closest('.attr-row').remove();
            });
        })();
    </script>
{% endblock %}
