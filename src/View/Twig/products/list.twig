{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('products.list_title') }}</h2>
            <div class="ms-auto me-2">{% include 'common/saved-filters.twig' with {page: 'products'} %}</div>
            <div class="d-flex gap-2">
                <a href="{{ base_url }}/products/export?{{ filters|url_encode }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i>{{ t('common.csv_export') }}
                </a>
                {% if can('products.manage') %}
                    <a href="{{ base_url }}/import/products" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-upload me-1"></i>{{ t('import.button') }}
                    </a>
                {% endif %}
                {% if can('products.manage') %}
                    <a href="{{ base_url }}/products/create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>{{ t('products.new') }}
                    </a>
                {% endif %}
            </div>
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                {{ sort_inputs() }}
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('products.search_placeholder') }}" value="{{ filters.q }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('products.category') }}</label>
                        <select name="category_id" class="form-select form-select-sm cx-ajax-select"
                                data-url="{{ base_url }}/categories/search" data-placeholder="{{ t('common.all') }}">
                            {% for opt in category_option|default([]) %}
                                <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.status') }}</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">{{ t('common.all') }}</option>
                            <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>{{ t('common.active') }}</option>
                            <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>{{ t('common.inactive') }}</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/products" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        {% if can('products.manage') %}<th style="width:36px;"><input type="checkbox" class="form-check-input" data-bulk-all aria-label="{{ t('bulk.all') }}"></th>{% endif %}
                        <th style="width:44px;"></th>
                        <th {{ sort_aria('sku') }}>{{ sort_link('sku', t('common.sku')) }}</th>
                        <th {{ sort_aria('name') }}>{{ sort_link('name', t('products.col_name')) }}</th>
                        <th {{ sort_aria('category') }}>{{ sort_link('category', t('products.category')) }}</th>
                        <th class="text-end" {{ sort_aria('stock') }}>{{ sort_link('stock', t('products.col_stock')) }}</th>
                        <th class="text-end" {{ sort_aria('price') }}>{{ sort_link('price', t('products.col_net_price')) }}</th>
                        <th {{ sort_aria('status') }}>{{ sort_link('status', t('common.status')) }}</th>
                        <th class="text-end">{{ t('common.actions') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for product in products %}
                        <tr>
                            {% if can('products.manage') %}<td><input type="checkbox" class="form-check-input" name="ids[]" value="{{ product.id }}" form="bulk-form" aria-label="{{ t('bulk.tick', {name: product.sku}) }}"></td>{% endif %}
                            <td>
                                {% if product.thumb %}
                                    <img src="{{ product.thumb starts with 'http' ? product.thumb : base_url ~ '/' ~ product.thumb }}" alt="" class="cx-row-thumb">
                                {% else %}
                                    <span class="cx-row-thumb cx-row-thumb--empty"><i class="bi bi-image"></i></span>
                                {% endif %}
                            </td>
                            <td class="fw-medium text-nowrap">{{ product.sku }}</td>
                            <td>
                                <a href="{{ base_url }}/products/{{ product.id }}/edit" class="text-decoration-none">{{ product.name }}</a>
                                {% if not product.is_webshop %}<i class="bi bi-shop-window text-muted ms-1" title="{{ t('products.not_webshop') }}"></i>{% endif %}
                            </td>
                            <td class="text-muted">{{ product.category_name ?: '—' }}</td>
                            <td class="text-end">
                                {% if product.stock_qty <= 0 %}
                                    {% set stockClass = 'bg-danger-subtle text-danger-emphasis' %}
                                {% elseif product.min_stock > 0 and product.stock_qty < product.min_stock %}
                                    {% set stockClass = 'bg-warning-subtle text-warning-emphasis' %}
                                {% else %}
                                    {% set stockClass = 'bg-success-subtle text-success-emphasis' %}
                                {% endif %}
                                <span class="badge rounded-pill {{ stockClass }}" {% if product.min_stock > 0 %}title="{{ t('products.min_prefix') }}: {{ product.min_stock|qty }}"{% endif %}>
                                    {{ product.stock_qty|qty }} {{ product.unit }}
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                {% if product.sale_price %}
                                    <span class="text-muted text-decoration-line-through small">{{ product.price|money }}</span><br>
                                    <span class="fw-medium text-danger">{{ product.sale_price|money }}</span>
                                {% else %}
                                    {{ product.price|money }}
                                {% endif %}
                            </td>
                            <td>
                                {% if product.is_active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ t('common.active') }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ t('common.inactive') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                {% if can('products.manage') %}
                                    <a href="{{ base_url }}/products/{{ product.id }}/edit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% endif %}
                                {% if can('products.manage') %}
                                    <form method="post" action="{{ base_url }}/products/{{ product.id }}/delete" class="d-inline" onsubmit="return confirm('{{ t('common.confirm_delete')|e('js') }}');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ can('products.manage') ? 9 : 8 }}" class="text-center text-muted py-4">{{ t('products.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if can('products.manage') and products is not empty %}
                <form method="post" action="{{ base_url }}/products/bulk" id="bulk-form" class="cx-bulk-bar border-top p-3 d-flex flex-wrap align-items-center gap-2" data-bulk-bar hidden>
                    <input type="hidden" name="back" value="{{ current_query() }}">
                    <strong class="small" data-bulk-count data-template="{{ t('bulk.count') }}"></strong>
                    <select name="action" class="form-select form-select-sm w-auto" aria-label="{{ t('bulk.action') }}" required>
                        <option value="activate">{{ t('bulk.activate') }}</option>
                        <option value="deactivate">{{ t('bulk.deactivate') }}</option>
                        <option value="webshop_on">{{ t('bulk.webshop_on') }}</option>
                        <option value="webshop_off">{{ t('bulk.webshop_off') }}</option>
                        <option value="category">{{ t('bulk.set_category') }}</option>
                    </select>
                    <div data-bulk-for="category" hidden style="min-width: 240px;">
                        <select name="category_id" class="form-select form-select-sm cx-ajax-select" data-url="{{ base_url }}/categories/search" data-placeholder="{{ t('bulk.choose_category') }}"></select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">{{ t('bulk.apply') }}</button>
                </form>
            {% endif %}
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
