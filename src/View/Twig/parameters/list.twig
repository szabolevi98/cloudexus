{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="cx-card">
                <div class="cx-card__header"><h2>{{ t('parameters.new') }}</h2></div>
                <div class="cx-card__body">
                    <form method="post" action="{{ base_url }}/parameters/create">
                        <div class="mb-3">
                            <label class="form-label">{{ t('common.name') }}</label>
                            {# Nyelvenként egy mező; a kötelező kitöltés az alapnyelvre vonatkozik. #}
                            {% for lang in languages %}
                                <div class="input-group input-group-sm mb-1">
                                    <span class="input-group-text" title="{{ lang.name }}">{{ lang.code|upper }}</span>
                                    <input type="text" name="name[{{ lang.id }}]" class="form-control" {{ loop.first ? 'required' : '' }}>
                                </div>
                            {% endfor %}
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>{{ t('common.add') }}</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="cx-card">
                <div class="cx-card__header">
                    <h2>{{ t('parameters.list_title') }}</h2>
                    <span class="text-muted small">{{ pager.total }} {{ t('common.pcs') }}</span>
                </div>
                <div class="cx-card__body p-0">
                    <form method="get" class="p-3 border-bottom">
                        {{ sort_inputs() }}
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-6 col-lg-5">
                                <label class="form-label small text-muted mb-1">{{ t('common.search') }}</label>
                                <input type="text" name="q" class="form-control form-control-sm" placeholder="{{ t('parameters.search_placeholder') }}" value="{{ filters.q }}">
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                                <a href="{{ base_url }}/parameters" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                            </div>
                        </div>
                    </form>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 cx-table">
                            <thead><tr><th {{ sort_aria('name') }}>{{ sort_link('name', t('common.name')) }}</th><th class="text-end">{{ t('common.actions') }}</th></tr></thead>
                            <tbody>
                            {% for n in names %}
                                <tr>
                                    <td>
                                        <form method="post" action="{{ base_url }}/parameters/{{ n.id }}" class="d-flex gap-2" style="max-width:400px;">
                                            <div class="flex-grow-1">
                                                {% for lang in languages %}
                                                    <div class="input-group input-group-sm {{ not loop.last ? 'mb-1' : '' }}">
                                                        <span class="input-group-text" title="{{ lang.name }}">{{ lang.code|upper }}</span>
                                                        <input type="text" name="name[{{ lang.id }}]" class="form-control" value="{{ n.names[lang.id]|default('') }}">
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-outline-primary">{{ t('common.save') }}</button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form method="post" action="{{ base_url }}/parameters/{{ n.id }}/delete" class="d-inline" data-confirm="{{ t('common.confirm_delete') }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="2" class="text-center text-muted py-4">{{ t('parameters.none_found') }}</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% include 'common/pagination.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
