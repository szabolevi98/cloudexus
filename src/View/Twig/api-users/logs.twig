{% extends 'common/layout.twig' %}

{% block content %}
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="cx-stat">
                <div class="cx-stat__icon"><i class="bi bi-list-check"></i></div>
                <div>
                    <div class="cx-stat__label">{{ t('api_logs.summary_total') }}</div>
                    <div class="cx-stat__value">{{ summary.total }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="cx-stat cx-stat--success">
                <div class="cx-stat__icon"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="cx-stat__label">{{ t('api_logs.summary_ok') }}</div>
                    <div class="cx-stat__value">{{ summary.ok }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="cx-stat cx-stat--warning">
                <div class="cx-stat__icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <div class="cx-stat__label">{{ t('api_logs.summary_client_error') }}</div>
                    <div class="cx-stat__value">{{ summary.client_error }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="cx-stat cx-stat--warning">
                <div class="cx-stat__icon"><i class="bi bi-speedometer2"></i></div>
                <div>
                    <div class="cx-stat__label">{{ t('api_logs.summary_rate_limited') }}</div>
                    <div class="cx-stat__value">{{ summary.rate_limited }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="cx-stat cx-stat--danger">
                <div class="cx-stat__icon"><i class="bi bi-x-circle"></i></div>
                <div>
                    <div class="cx-stat__label">{{ t('api_logs.summary_server_error') }}</div>
                    <div class="cx-stat__value">{{ summary.server_error }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('api_logs.list_title') }}</h2>
            <span class="text-muted small">{{ t('api_logs.retention_hint', {'days': retention_days}) }}</span>
        </div>
        <div class="cx-card__body p-0">
            <form method="get" class="p-3 border-bottom">
                <div class="row g-2 align-items-end">
                    <div class="col-sm-4 col-lg-3">
                        <label class="form-label small text-muted mb-1">{{ t('api_logs.api_user') }}</label>
                        <select name="api_user_id" class="form-select form-select-sm">
                            <option value="">{{ t('api_logs.all_users') }}</option>
                            {% for u in api_users %}
                                <option value="{{ u.id }}" {{ filters.api_user_id == u.id ? 'selected' : '' }}>{{ u.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('api_logs.outcome') }}</label>
                        <select name="outcome" class="form-select form-select-sm">
                            <option value="">{{ t('api_logs.outcome_all') }}</option>
                            <option value="ok" {{ filters.outcome == 'ok' ? 'selected' : '' }}>{{ t('api_logs.outcome_ok') }}</option>
                            <option value="client_error" {{ filters.outcome == 'client_error' ? 'selected' : '' }}>{{ t('api_logs.outcome_client_error') }}</option>
                            <option value="rate_limited" {{ filters.outcome == 'rate_limited' ? 'selected' : '' }}>{{ t('api_logs.outcome_rate_limited') }}</option>
                            <option value="server_error" {{ filters.outcome == 'server_error' ? 'selected' : '' }}>{{ t('api_logs.outcome_server_error') }}</option>
                        </select>
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.date_from') }}</label>
                        <input type="date" name="date_from" class="form-control form-control-sm" value="{{ filters.date_from }}">
                    </div>
                    <div class="col-sm-3 col-lg-2">
                        <label class="form-label small text-muted mb-1">{{ t('common.date_to') }}</label>
                        <input type="date" name="date_to" class="form-control form-control-sm" value="{{ filters.date_to }}">
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>{{ t('common.filter') }}</button>
                        <a href="{{ base_url }}/api-logs" class="btn btn-sm btn-outline-secondary">{{ t('common.clear') }}</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 cx-table">
                    <thead>
                    <tr>
                        <th>{{ t('api_logs.col_time') }}</th>
                        <th>{{ t('api_logs.col_user') }}</th>
                        <th>{{ t('api_logs.col_method_path') }}</th>
                        <th>{{ t('api_logs.col_status') }}</th>
                        <th class="text-end">{{ t('api_logs.col_duration') }}</th>
                        <th>{{ t('api_logs.col_ip') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for l in logs %}
                        <tr>
                            <td class="text-muted text-nowrap">{{ l.created_at }}</td>
                            <td>{{ l.api_user_name ?: t('api_logs.unknown_user') }}</td>
                            <td><code>{{ l.method }} {{ l.path }}</code></td>
                            <td>
                                {% if l.status_code is null %}
                                    <span class="badge rounded-pill bg-body-tertiary text-body border">—</span>
                                {% elseif l.status_code < 400 %}
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis">{{ l.status_code }}</span>
                                {% elseif l.status_code == 429 %}
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">{{ l.status_code }}</span>
                                {% elseif l.status_code < 500 %}
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">{{ l.status_code }}</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">{{ l.status_code }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end text-muted">{{ l.duration_ms is not null ? l.duration_ms ~ ' ms' : '—' }}</td>
                            <td class="text-muted">{{ l.ip_address }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">{{ t('api_logs.none_found') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'common/pagination.twig' %}
        </div>
    </div>
{% endblock %}
