{
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.21",
        "phpmailer/phpmailer": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "Cloudexus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cloudexus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "platform-check": false
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
